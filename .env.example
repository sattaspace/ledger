SB_API_KEY_ENFORCED=false


# ═════════════════════════════════════════════════════════════════════════════
# SECTION 3: DEALERBACKEND (port 8088)
# ═════════════════════════════════════════════════════════════════════════════
#
# These variables are read by dealerbackend/dealercore/settings.py.
# DealerBackend is the dealer management system. It receives SattaBase-issued
# JWTs from dealers (must verify them) and DSR-issued JWTs from DSRs
# (signed with its own SECRET_KEY).
#

# ── Core Django ──
# DB_SECRET_KEY is INDEPENDENT from SB_SECRET_KEY and SHARED_JWT_SIGNING_KEY.
# It is used for Django internals (sessions, CSRF) AND for signing DSR JWTs
# (via NINJA_JWT SIGNING_KEY setting).
DB_DEBUG=true
DB_SECRET_KEY=django-insecure-=3$*v73(-9%a#8$*ba7$spzzk4$!zqqq75vm)7y12%jtjpc_q4

# ── Database (DealerBackend has its own database) ──
DB_DB_NAME=dealercore_db
DB_DB_USER=dealercore_user
DB_DB_PASSWORD=dealercore_password
DB_DB_HOST=localhost
DB_DB_PORT=5432
DB_DATABASE_URL=postgres://dealercore_user:dealercore_password@localhost:5432/dealercore_db

# ── CORS ──
DB_CORS_ALLOWED_ORIGINS=http://localhost:4323,http://localhost:4321,http://127.0.0.1:4323

# ── JWT: Verify SattaBase-issued dealer JWTs ──
# SATTABASE_JWT_SHARED_SECRET must equal SHARED_JWT_SIGNING_KEY (Section 1)
# and SB_JWT_SIGNING_KEY (Section 2). All three must be the same value.
# This is how DealerBackend verifies that a dealer's JWT was genuinely
# issued by SattaBase (not forged).
#
# In production with RS256: set SATTABASE_JWT_PUBLIC_KEY instead and
# leave SATTABASE_JWT_SHARED_SECRET empty.
SATTABASE_JWT_SHARED_SECRET=django-insecure-m3#t!j0&3sck0zplae=r4!@=3tj*h^o&&kyu7%=#rme-l6#-d_p
SATTABASE_JWT_ALGORITHM=HS256
# SattaBase JWT doesn't include iss/aud claims, so leave these empty
# SATTABASE_JWT_ISSUER=sattabase
# SATTABASE_JWT_AUDIENCE=dealercore
SATTABASE_JWT_PUBLIC_KEY=

# ── Server-to-Server API: DealerBackend → SattaBase ──
# This API key authenticates the DealerBackend when it calls SattaBase's
# /billing/service/subscriber/access endpoint to fetch the dealer's
# access matrix. Created in SattaBase admin → API Keys.
#
# This is DIFFERENT from the JWT shared secret above:
#   - JWT shared secret = verify client-sent JWTs (dealer → DealerBackend)
#   - API key = authenticate server-to-server calls (DealerBackend → SattaBase)
SATTABASE_API_BASE_URL=http://localhost:8086
SATTABASE_API_KEY=sb_live__qoUu-jmS7e1BQsmYenCAVn5c4rBY4zMpbwgBPri1Wc
SATTABASE_SERVICE_DOMAIN=localhost:4323

# ── Access Control ──
SATTABASE_ACCESS_CACHE_TTL=300
# Strict mode: when SattaBase is unreachable, deny all (true) or allow all (false)
# false = dev-friendly (keeps working without SattaBase)
# true = production (fails closed — all gated modules denied)
SATTABASE_ACCESS_STRICT_MODE=false

# ── Feature Flags ──
ENABLE_SUBSCRIPTION_CHECK=True
ENABLE_ACCESS_MATRIX=True


# ═════════════════════════════════════════════════════════════════════════════
# SECTION 4: DEALERFRONTEND (Astro, port 4323)
# ═════════════════════════════════════════════════════════════════════════════
#
# These PUBLIC_ variables are exposed to the browser via Vite/Astro.
# They are read by sattabase.config.ts and astro.config.mjs.
#

# ── API URLs (browser → backend) ──
# SattaBase API (for dealer auth, billing, profile)
PUBLIC_API_BASE_URL_SB=http://localhost:8086/api/v1
# DealerBackend API (for inventory, sales, DSR management, etc.)
PUBLIC_DEALER_API_URL=http://localhost:8088/api

# ── Domain URLs ──
# SattaBase frontend (for register, forgot-password, billing redirects)
PUBLIC_BASE_DOMAIN_URL=http://localhost:4321
# This sister domain's URL (for return redirects after billing)
PUBLIC_THIS_DOMAIN_URL=http://localhost:4323
# Service domain identifier (must match ServiceDomain in SattaBase DB)
PUBLIC_SERVICE_DOMAIN=localhost:4323

# ── Token storage prefix (domain-specific localStorage key prefix) ──
PUBLIC_TOKEN_KEY_PREFIX=dealercore:

# ── Session cookie name (must match SattaBase backend) ──
PUBLIC_SESSION_COOKIE_NAME=sattabase_session_cookie
