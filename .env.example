# Core Django Settings
SB_DEBUG=true
SB_SECRET_KEY="your-django-secret-key"
SB_SESSION_COOKIE_NAME="sattabase_session_cookie"
SECURE_HSTS_SECONDS=31536000

# Security & Network (Hosts & CORS)
SB_ALLOWED_HOSTS=localhost,127.0.0.1
SB_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8085,http://localhost:4321,http://localhost:8085,http://127.0.0.1:4321

# CORS Settings
SB_CORS_ALLOW_ALL_ORIGINS=true
SB_CORS_ALLOWED_ORIGINS=http://localhost:4321,http://localhost:8085,http://127.0.0.1:4321,http://127.0.0.1:8085



# Database Settings

SB_DB_NAME=sattabase_db
SB_DB_USER=sattabase_user
SB_DB_PASSWORD=sattabase_password
SB_DB_HOST=localhost
SB_DB_PORT=5432
SB_DATABASE_URL=postgres://sattabase_user:sattabase_password@localhost:5432/sattabase_db


# Redis & Celery

SB_REDIS_HOST=localhost
SB_REDIS_PORT=6379


# JWT Authentication

SB_JWT_ACCESS_TOKEN_MINUTES=60
SB_JWT_REFRESH_TOKEN_DAYS=7
SB_JWT_ALGORITHM=HS256
SB_JWT_ROTATE_REFRESH_TOKENS=True
SB_JWT_BLACKLIST_AFTER_ROTATION=True
SB_JWT_SIGNING_KEY="your-jwt-signing-key"
  
# Rate Limiting & Password Security
SB_RATE_LIMIT_LOGIN_ATTEMPTS=10
SB_RATE_LIMIT_LOGIN_WINDOW=900
SB_RATE_LIMIT_REGISTER_ATTEMPTS=5
SB_RATE_LIMIT_REGISTER_WINDOW=3600
SB_RATE_LIMIT_PASSWORD_RESET_ATTEMPTS=5
SB_RATE_LIMIT_PASSWORD_RESET_WINDOW=3600
SB_RATE_LIMIT_SDK_ATTEMPTS=1000
SB_RATE_LIMIT_SDK_WINDOW=3600
SB_RATE_LIMIT_SENSITIVE_WINDOW=3600
SB_RATE_LIMIT_SENSITIVE_ATTEMPTS=5
SB_PASSWORD_RESET_TOKEN_EXPIRY=900


# Email Configuration

SB_EMAIL_HOST=smtp.gmail.com
SB_EMAIL_PORT=587
SB_EMAIL_USE_TLS=true
SB_EMAIL_HOST_USER=base@sattaspace.com
SB_EMAIL_HOST_PASSWORD=your-email-password
SB_DEFAULT_FROM_EMAIL=base@sattaspace.com


# Stripe Integration
SB_STRIPE_SECRET_KEY=sk_test_your_secret_key
SB_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
SB_STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
SB_STRIPE_APP_DOMAIN=http://localhost:4321
SB_STRIPE_TAX_ENABLED=True

# URL & App Settings

# General
PUBLIC_APP_NAME=SattaBase
PUBLIC_SITE_URL=http://localhost:4321

# Backend & API
SB_BACKEND_URL=http://localhost:8086
SB_BACKEND_PUBLIC_API_URL=http://localhost:8086/api
PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Misc & External APIs
SB_TOS_VERSION=1.0
SB_BASE_CURRENCY=USD
SB_EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest
