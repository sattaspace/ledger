# ═════════════════════════════════════════════════════════════════════════════
# CENTRAL ENVIRONMENT CONFIGURATION — SattaBase Project
# ═════════════════════════════════════════════════════════════════════════════
#
# This is the SINGLE source of truth for all environment variables.
# Both backends (SattaBase on 8086, DealerBackend on 8088) and the
# DealerFrontend (Astro on 4323) read from this file.
#
# Prefix convention:
#   SB_       → SattaBase backend only (port 8086)
#   DB_       → DealerBackend only (port 8088)
#   SHARED_   → Used by BOTH backends (e.g. JWT signing key)
#   PUBLIC_   → Exposed to frontend (Astro/Vite)
#
# To load this file, each backend's manage.py / settings.py should
# load the .env from the project root using python-dotenv:
#   from dotenv import load_dotenv
#   load_dotenv("/path/to/sattabase/.env")
#
# ═════════════════════════════════════════════════════════════════════════════


# ═════════════════════════════════════════════════════════════════════════════
# SECTION 1: SHARED JWT KEY (used by BOTH backends)
# ═════════════════════════════════════════════════════════════════════════════
#
# This is the SINGLE key that ties the two backends together:
#
#   - SattaBase (8086) SIGNS dealer JWTs with this key (SB_JWT_SIGNING_KEY)
#   - DealerBackend (8088) VERIFIES those dealer JWTs with the SAME key
#     (SATTABASE_JWT_SHARED_SECRET)
#
# Both must be the same value. In dev with HS256, this is a shared secret.
# In production with RS256, SattaBase uses a private key to sign and
# DealerBackend uses the corresponding public key to verify — in that case
# set SB_JWT_SIGNING_KEY (private) on SattaBase and
# SATTABASE_JWT_PUBLIC_KEY (public) on DealerBackend instead.
#
# This key is INDEPENDENT from both backends' Django SECRET_KEY.
# Do NOT use either backend's SECRET_KEY as the JWT signing key.
#
SHARED_JWT_SIGNING_KEY=django-insecure-m3#t!j0&3sck0zplae=r4!@=3tj*h^o&&kyu7%=#rme-l6#-d_p
SHARED_JWT_ALGORITHM=HS256


# ═════════════════════════════════════════════════════════════════════════════
# SECTION 2: SATTABASE BACKEND (port 8086)
# ═════════════════════════════════════════════════════════════════════════════
#
# These variables are read by backend/base/settings.py.
# SattaBase is the central SaaS billing platform that issues dealer JWTs,
# manages subscriptions/plans/access entries, and provides the
# /billing/service/subscriber/access endpoint for sister domains.
#

# ── Core Django ──
SB_DEBUG=true
SB_SECRET_KEY=django-insecure-m3#t!j0&3sck0zplae=r4!@=3tj*h^o&&kyu7%=#rme-l6#-d_p
SB_SESSION_COOKIE_NAME=sattabase_session_cookie
SB_CRYPTOGRAPHY_KEY=4753a314a25ae29f6e806786591be407256b3502ce6b4fc70b5952a31bb02af5

# ── Security & Network ──
SB_ALLOWED_HOSTS=localhost,127.0.0.1,supranaturalistic-socorro-nonhypnotically.ngrok-free.dev,baseapi.sattaspace.com
SB_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:4321,http://localhost:8000,http://127.0.0.1:4321,http://127.0.0.1:4323,http://localhost:4323,https://supranaturalistic-socorro-nonhypnotically.ngrok-free.dev,http://sb-backend:8000,http://sb-frontend:4321,https://baseapi.sattaspace.com
SB_CORS_ALLOWED_ORIGINS=http://localhost:4321,http://localhost:4322,http://localhost:8000,http://127.0.0.1:4321,http://127.0.0.1:4323,http://localhost:4323,http://127.0.0.1:8000,https://supranaturalistic-socorro-nonhypnotically.ngrok-free.dev,http://sb-backend:8000,http://sb-frontend:4321,https://baseapi.sattaspace.com

# ── Database ──
SB_DB_NAME=sattabase_db
SB_DB_USER=sattabase_user
SB_DB_PASSWORD=sattabase_password
SB_DB_HOST=localhost
SB_DB_PORT=5432
SB_DATABASE_URL=postgres://sattabase_user:sattabase_password@localhost:5432/sattabase_db

# ── Redis & Celery ──
SB_REDIS_HOST=sb-redis
SB_REDIS_PORT=6379

# ── JWT Authentication (SattaBase SIGNS dealer JWTs with this) ──
# SB_JWT_SIGNING_KEY must equal SHARED_JWT_SIGNING_KEY above.
# settings.py reads SB_JWT_SIGNING_KEY; we set it from SHARED_ for clarity.
SB_JWT_SIGNING_KEY=django-insecure-m3#t!j0&3sck0zplae=r4!@=3tj*h^o&&kyu7%=#rme-l6#-d_p
SB_JWT_ALGORITHM=HS256
SB_JWT_ACCESS_TOKEN_MINUTES=60
SB_JWT_REFRESH_TOKEN_DAYS=7
SB_JWT_ROTATE_REFRESH_TOKENS=True
SB_JWT_BLACKLIST_AFTER_ROTATION=True

# ── Rate Limiting & Password Security ──
SB_RATE_LIMIT_LOGIN_ATTEMPTS=10
SB_RATE_LIMIT_LOGIN_WINDOW=900
SB_RATE_LIMIT_REGISTER_ATTEMPTS=5
SB_RATE_LIMIT_REGISTER_WINDOW=3600
SB_RATE_LIMIT_PASSWORD_RESET_ATTEMPTS=5
SB_RATE_LIMIT_PASSWORD_RESET_WINDOW=3600
SB_RATE_LIMIT_SDK_ATTEMPTS=1000
SB_RATE_LIMIT_SDK_WINDOW=3600
SB_RATE_LIMIT_SENSITIVE_WINDOW=3600
SB_RATE_LIMIT_SENSITIVE_ATTEMPTS=5
SB_PASSWORD_RESET_TOKEN_EXPIRY=900

# ── Email Configuration ──
SB_EMAIL_HOST=smtp.gmail.com
SB_EMAIL_PORT=587
SB_EMAIL_USE_TLS=true
SB_EMAIL_HOST_USER=base@sattaspace.com
SB_EMAIL_HOST_PASSWORD=123456
SB_DEFAULT_FROM_EMAIL=base@sattaspace.com

# ── Stripe Integration ──
SB_STRIPE_SECRET_KEY=sk_test_51GYVUACPjevOheLTlghHpxxky7KUV5HEN9yOv2myMYhQPSGIEJe3VRlOVLzcJFtls8JqNtIs6j2Va9VVqRMtKkv500jKMIEZn1
SB_STRIPE_PUBLISHABLE_KEY=pk_test_oIAUclLp1uNOh2U6bVjkdQkk00jyyEX3hN
SB_STRIPE_WEBHOOK_SECRET=whsec_yXC523UAatMMaD5mt52XvpSKjF06Nsdn
SB_STRIPE_APP_DOMAIN=https://base.sattaspace.com
SB_STRIPE_TAX_ENABLED=True

# ── URL & App Settings ──
PUBLIC_APP_NAME_SB=SattaBase
PUBLIC_SITE_URL_SB=https://base.sattaspace.com
PUBLIC_API_BASE_URL_SB=http://localhost:8086/api/v1
SERVER_API_BASE_URL_SB=http://sb-backend:8086/api/v1

# ── Misc & External APIs ──
SB_TOS_VERSION=1.0
SB_BASE_CURRENCY=USD
