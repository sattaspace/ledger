---
/**
 * Sidebar — full navigation sidebar for Satta Ledger dashboard.
 *
 * Includes logo, top accent gradient, collapsible navigation sections,
 * subscription status, user info, and sign out button.
 *
 * Keyboard navigation support (arrow keys).
 * Active nav indicator with left bar + cyan background.
 */

interface NavItem {
  label: string;
  href: string;
  icon: string; // SVG path data
  /** Feature key for gating (undefined = always visible). */
  feature?: string;
}

interface NavSection {
  title: string;
  items: NavItem[];
}

const navSections: NavSection[] = [
