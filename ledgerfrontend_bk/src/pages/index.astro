---
/**
 * Landing Page — Satta Ledger marketing homepage.
 *
 * Full-page scrollable marketing landing with hero, features,
 * how-it-works, multicurrency, CTA, and footer sections.
 */

import BaseLayout from "@/layouts/BaseLayout.astro";
import LoginForm from "@/components/vue/LoginForm.vue";
---

<BaseLayout title="Satta Ledger — Your Complete Personal Finance Manager" description="Track income, expenses, budgets, investments, and more across multiple currencies with Satta Ledger.">
  <div class="flex flex-col min-h-full overflow-y-auto">

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- HERO SECTION                                                      -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <section class="relative min-h-[90vh] flex items-center overflow-hidden bg-navy-gradient">
      <!-- Animated floating blobs -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
        <div class="absolute -top-20 -left-20 w-72 h-72 rounded-full bg-cyan-600/10 blur-3xl animate-blob1"></div>
        <div class="absolute top-1/3 right-1/4 w-96 h-96 rounded-full bg-cyan-500/8 blur-3xl animate-blob2"></div>
        <div class="absolute bottom-0 left-1/3 w-80 h-80 rounded-full bg-warm-600/6 blur-3xl animate-blob3"></div>
        <div class="absolute top-10 right-10 w-48 h-48 rounded-full bg-cyan-400/5 blur-2xl animate-blob4"></div>
      </div>

      <div class="relative z-10 mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
          <!-- Left: Hero text -->
          <div class="text-center lg:text-left animate-fade-in">
            <div class="inline-flex items-center gap-2 rounded-full bg-cyan-600/15 border border-cyan-500/20 px-4 py-1.5 mb-6">
              <div class="h-2 w-2 rounded-full bg-cyan-400 animate-pulse"></div>
              <span class="text-sm font-medium text-cyan-300">Personal Finance SaaS</span>
            </div>
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white text-balance">
              Your Complete<br />
              <span class="bg-gradient-to-r from-cyan-400 to-cyan-200 bg-clip-text text-transparent">Personal Ledger</span>
            </h1>
            <p class="mt-6 text-lg sm:text-xl text-navy-200 max-w-xl mx-auto lg:mx-0 text-pretty">
              Track income, expenses, budgets, investments, and more across multiple currencies. All your finances in one powerful, intuitive dashboard.
            </p>
            <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
              <a href="/auth/login" class="btn-primary bg-warm-600 hover:bg-warm-700 text-white shadow-lg shadow-warm-600/25 px-6 py-3 text-base">
                Get Started
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg>
              </a>
              <a href="#features" class="btn-secondary border-navy-500/30 bg-white/5 text-white hover:bg-white/10 hover:border-navy-400/40 px-6 py-3 text-base">
                Learn More
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </a>
            </div>
            <!-- Trust indicators -->
            <div class="mt-10 flex items-center gap-6 justify-center lg:justify-start text-navy-300">
              <div class="flex items-center gap-2">
                <svg class="h-5 w-5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                <span class="text-sm">Secure & Private</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="h-5 w-5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064"></path></svg>
                <span class="text-sm">Multi-currency</span>
              </div>
            </div>
          </div>

          <!-- Right: Login form card -->
          <div class="animate-slide-up">
            <div class="glass-navy rounded-2xl border border-navy-500/20 p-6 sm:p-8 shadow-2xl shadow-black/20 max-w-md mx-auto lg:mx-0 lg:ml-auto">
              <LoginForm client:only="vue" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- FEATURES SECTION                                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <section id="features" class="py-20 lg:py-28 bg-cloud dark:bg-navy-950">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <span class="inline-block text-sm font-semibold text-cyan-600 dark:text-cyan-400 uppercase tracking-wider mb-3">Everything You Need</span>
          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-navy-900 dark:text-navy-100">
            16 Powerful Features
          </h2>
          <p class="mt-4 text-lg text-slate-custom-700 dark:text-slate-custom-400 max-w-2xl mx-auto">
            From daily expenses to long-term investments, Satta Ledger covers every aspect of your personal finances.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          <!-- Income -->
          <div class="group glass-white dark:glass-navy rounded-xl border border-navy-200/60 dark:border-navy-700/40 p-5 hover:border-cyan-400/50 dark:hover:border-cyan-500/30 transition-all duration-300 hover:shadow-lg hover:shadow-cyan-500/5">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-credit/10 mb-3">
              <svg class="h-5 w-5 text-credit" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v16m8-8H4"></path></svg>
            </div>
            <h3 class="font-semibold text-navy-900 dark:text-navy-100">Income</h3>
            <p class="mt-1 text-sm text-slate-custom-600 dark:text-slate-custom-400">Track all income sources with recurring entries</p>
          </div>

          <!-- Expense -->
          <div class="group glass-white dark:glass-navy rounded-xl border border-navy-200/60 dark:border-navy-700/40 p-5 hover:border-cyan-400/50 dark:hover:border-cyan-500/30 transition-all duration-300 hover:shadow-lg hover:shadow-cyan-500/5">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-debit/10 mb-3">
              <svg class="h-5 w-5 text-debit" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 12H4"></path></svg>
            </div>
            <h3 class="font-semibold text-navy-900 dark:text-navy-100">Expense</h3>
            <p class="mt-1 text-sm text-slate-custom-600 dark:text-slate-custom-400">Categorize and monitor every spending</p>
          </div>

          <!-- Loan -->
          <div class="group glass-white dark:glass-navy rounded-xl border border-navy-200/60 dark:border-navy-700/40 p-5 hover:border-cyan-400/50 dark:hover:border-cyan-500/30 transition-all duration-300 hover:shadow-lg hover:shadow-cyan-500/5">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-cyan-100 dark:bg-cyan-950 mb-3">
              <svg class="h-5 w-5 text-cyan-600 dark:text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
            </div>
            <h3 class="font-semibold text-navy-900 dark:text-navy-100">Loan</h3>
            <p class="mt-1 text-sm text-slate-custom-600 dark:text-slate-custom-400">Manage loans with amortization schedules</p>
          </div>

          <!-- Bank Account -->
          <div class="group glass-white dark:glass-navy rounded-xl border border-navy-200/60 dark:border-navy-700/40 p-5 hover:border-cyan-400/50 dark:hover:border-cyan-500/30 transition-all duration-300 hover:shadow-lg hover:shadow-cyan-500/5">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-cyan-100 dark:bg-cyan-950 mb-3">
              <svg class="h-5 w-5 text-cyan-600 dark:text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
            </div>
            <h3 class="font-semibold text-navy-900 dark:text-navy-100">Bank Account</h3>
            <p class="mt-1 text-sm text-slate-custom-600 dark:text-slate-custom-400">Sync and monitor all bank balances</p>
          </div>

          <!-- Card -->
          <div class="group glass-white dark:glass-navy rounded-xl border border-navy-200/60 dark:border-navy-700/40 p-5 hover:border-cyan-400/50 dark:hover:border-cyan-500/30 transition-all duration-300 hover:shadow-lg hover:shadow-cyan-500/5">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-warm-100 dark:bg-warm-950 mb-3">
              <svg class="h-5 w-5 text-warm-600 dark:text-warm-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
            </div>
            <h3 class="font-semibold text-navy-900 dark:text-navy-100">Card</h3>
            <p class="mt-1 text-sm text-slate-custom-600 dark:text-slate-custom-400">Debit & credit cards with spending limits</p>
          </div>

          <!-- Lending -->
          <div class="group glass-white dark:glass-navy rounded-xl border border-navy-200/60 dark:border-navy-700/40 p-5 hover:border-cyan-400/50 dark:hover:border-cyan-500/30 transition-all duration-300 hover:shadow-lg hover:shadow-cyan-500/5">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-cyan-100 dark:bg-cyan-950 mb-3">
              <svg class="h-5 w-5 text-cyan-600 dark:text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path></svg>
            </div>
            <h3 class="font-semibold text-navy-900 dark:text-navy-100">Lending</h3>
            <p class="mt-1 text-sm text-slate-custom-600 dark:text-slate-custom-400">Track money lent to friends & family</p>
          </div>

          <!-- Mortgage -->
          <div class="group glass-white dark:glass-navy rounded-xl border border-navy-200/60 dark:border-navy-700/40 p-5 hover:border-cyan-400/50 dark:hover:border-cyan-500/30 transition-all duration-300 hover:shadow-lg hover:shadow-cyan-500/5">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-cyan-100 dark:bg-cyan-950 mb-3">
              <svg class="h-5 w-5 text-cyan-600 dark:text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
            </div>
            <h3 class="font-semibold text-navy-900 dark:text-navy-100">Mortgage</h3>
            <p class="mt-1 text-sm text-slate-custom-600 dark:text-slate-custom-400">Home mortgage tracking & payoff plans</p>
          </div>

          <!-- Mortgage Held -->
          <div class="group glass-white dark:glass-navy rounded-xl border border-navy-200/60 dark:border-navy-700/40 p-5 hover:border-cyan-400/50 dark:hover:border-cyan-500/30 transition-all duration-300 hover:shadow-lg hover:shadow-cyan-500/5">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-cyan-100 dark:bg-cyan-950 mb-3">
              <svg class="h-5 w-5 text-cyan-600 dark:text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
            </div>
            <h3 class="font-semibold text-navy-900 dark:text-navy-100">Mortgage Held</h3>
            <p class="mt-1 text-sm text-slate-custom-600 dark:text-slate-custom-400">Mortgages you hold as a lender</p>
          </div>

          <!-- Bill -->
          <div class="group glass-white dark:glass-navy rounded-xl border border-navy-200/60 dark:border-navy-700/40 p-5 hover:border-cyan-400/50 dark:hover:border-cyan-500/30 transition-all duration-300 hover:shadow-lg hover:shadow-cyan-500/5">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-warm-100 dark:bg-warm-950 mb-3">
              <svg class="h-5 w-5 text-warm-600 dark:text-warm-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>
            </div>
            <h3 class="font-semibold text-navy-900 dark:text-navy-100">Bill</h3>
            <p class="mt-1 text-sm text-slate-custom-600 dark:text-slate-custom-400">Bill reminders & recurring payment tracking</p>
          </div>

          <!-- Budget -->
          <div class="group glass-white dark:glass-navy rounded-xl border border-navy-200/60 dark:border-navy-700/40 p-5 hover:border-cyan-400/50 dark:hover:border-cyan-500/30 transition-all duration-300 hover:shadow-lg hover:shadow-cyan-500/5">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-cyan-100 dark:bg-cyan-950 mb-3">
              <svg class="h-5 w-5 text-cyan-600 dark:text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
            </div>
            <h3 class="font-semibold text-navy-900 dark:text-navy-100">Budget</h3>
            <p class="mt-1 text-sm text-slate-custom-600 dark:text-slate-custom-400">Set budgets & track spending by category</p>
          </div>

          <!-- Invoice -->
          <div class="group glass-white dark:glass-navy rounded-xl border border-navy-200/60 dark:border-navy-700/40 p-5 hover:border-cyan-400/50 dark:hover:border-cyan-500/30 transition-all duration-300 hover:shadow-lg hover:shadow-cyan-500/5">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-cyan-100 dark:bg-cyan-950 mb-3">
              <svg class="h-5 w-5 text-cyan-600 dark:text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            </div>
            <h3 class="font-semibold text-navy-900 dark:text-navy-100">Invoice</h3>
            <p class="mt-1 text-sm text-slate-custom-600 dark:text-slate-custom-400">Create & track personal invoices</p>
          </div>

          <!-- Investment -->
          <div class="group glass-white dark:glass-navy rounded-xl border border-navy-200/60 dark:border-navy-700/40 p-5 hover:border-cyan-400/50 dark:hover:border-cyan-500/30 transition-all duration-300 hover:shadow-lg hover:shadow-cyan-500/5">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-credit/10 mb-3">
              <svg class="h-5 w-5 text-credit" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
            </div>
            <h3 class="font-semibold text-navy-900 dark:text-navy-100">Investment</h3>
            <p class="mt-1 text-sm text-slate-custom-600 dark:text-slate-custom-400">Portfolio tracking with performance metrics</p>
          </div>

          <!-- Financial Calendar -->
          <div class="group glass-white dark:glass-navy rounded-xl border border-navy-200/60 dark:border-navy-700/40 p-5 hover:border-cyan-400/50 dark:hover:border-cyan-500/30 transition-all duration-300 hover:shadow-lg hover:shadow-cyan-500/5">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-cyan-100 dark:bg-cyan-950 mb-3">
              <svg class="h-5 w-5 text-cyan-600 dark:text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
            </div>
            <h3 class="font-semibold text-navy-900 dark:text-navy-100">Financial Calendar</h3>
            <p class="mt-1 text-sm text-slate-custom-600 dark:text-slate-custom-400">Schedule & visualize financial events</p>
          </div>

          <!-- Savings Goal -->
          <div class="group glass-white dark:glass-navy rounded-xl border border-navy-200/60 dark:border-navy-700/40 p-5 hover:border-cyan-400/50 dark:hover:border-cyan-500/30 transition-all duration-300 hover:shadow-lg hover:shadow-cyan-500/5">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-warm-100 dark:bg-warm-950 mb-3">
              <svg class="h-5 w-5 text-warm-600 dark:text-warm-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
            <h3 class="font-semibold text-navy-900 dark:text-navy-100">Savings Goal</h3>
            <p class="mt-1 text-sm text-slate-custom-600 dark:text-slate-custom-400">Set & track savings targets visually</p>
          </div>

          <!-- Insurance -->
          <div class="group glass-white dark:glass-navy rounded-xl border border-navy-200/60 dark:border-navy-700/40 p-5 hover:border-cyan-400/50 dark:hover:border-cyan-500/30 transition-all duration-300 hover:shadow-lg hover:shadow-cyan-500/5">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-cyan-100 dark:bg-cyan-950 mb-3">
              <svg class="h-5 w-5 text-cyan-600 dark:text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
            </div>
            <h3 class="font-semibold text-navy-900 dark:text-navy-100">Insurance</h3>
            <p class="mt-1 text-sm text-slate-custom-600 dark:text-slate-custom-400">Manage policies & premium reminders</p>
          </div>

          <!-- Documents Vault -->
          <div class="group glass-white dark:glass-navy rounded-xl border border-navy-200/60 dark:border-navy-700/40 p-5 hover:border-cyan-400/50 dark:hover:border-cyan-500/30 transition-all duration-300 hover:shadow-lg hover:shadow-cyan-500/5">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-cyan-100 dark:bg-cyan-950 mb-3">
              <svg class="h-5 w-5 text-cyan-600 dark:text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"></path></svg>
            </div>
            <h3 class="font-semibold text-navy-900 dark:text-navy-100">Documents Vault</h3>
            <p class="mt-1 text-sm text-slate-custom-600 dark:text-slate-custom-400">Secure storage for financial documents</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- HOW IT WORKS SECTION                                              -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <section class="py-20 lg:py-28 bg-white dark:bg-navy-900">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <span class="inline-block text-sm font-semibold text-cyan-600 dark:text-cyan-400 uppercase tracking-wider mb-3">Simple Setup</span>
