---
/**
 * Investment detail page — /dashboard/investments/[id]
 */

import DashboardLayout from "@/layouts/DashboardLayout.astro";
import InvestmentDetail from "@/components/vue/investments/InvestmentDetail.vue";
---

<DashboardLayout title="Investment Detail — Satta Ledger">
  <InvestmentDetail client:only="vue" id={Astro.params.id} />
</DashboardLayout>

<script>
  const pageTitle = document.getElementById("page-title");
  if (pageTitle) pageTitle.textContent = "Investment Detail";
</script>
