---
/**
 * Document Vault detail page — /dashboard/vault/[id]
 */

import DashboardLayout from "@/layouts/DashboardLayout.astro";
import VaultDetail from "@/components/vue/vault/VaultDetail.vue";
---

<DashboardLayout title="Document Detail — Satta Ledger">
  <VaultDetail client:only="vue" id={Astro.params.id} />
</DashboardLayout>

<script>
  const pageTitle = document.getElementById("page-title");
  if (pageTitle) pageTitle.textContent = "Document Detail";
</script>
