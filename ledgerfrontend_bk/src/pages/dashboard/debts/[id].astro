---
/**
 * Debt detail page — /dashboard/debts/[id]
 */

import DashboardLayout from "@/layouts/DashboardLayout.astro";
import DebtDetail from "@/components/vue/debts/DebtDetail.vue";
---

<DashboardLayout title="Debt Detail — Satta Ledger">
  <DebtDetail client:only="vue" id={Astro.params.id} />
</DashboardLayout>

<script>
  const pageTitle = document.getElementById("page-title");
  if (pageTitle) pageTitle.textContent = "Debt Detail";
</script>
