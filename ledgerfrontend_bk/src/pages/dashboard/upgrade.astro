---
import DashboardLayout from "@/layouts/DashboardLayout.astro";

const feature = Astro.url.searchParams.get("feature") || "";

const featureLabels: Record<string, string> = {
  budgets: "Budgets",
  goals: "Savings Goals",
  investments: "Investments",
  debts: "Debts",
  cards: "Cards",
  insurance: "Insurance",
  invoices: "Invoices",
  vault: "Document Vault",
};

const featureLabel = featureLabels[feature] || feature || "this feature";
---

<DashboardLayout title="Upgrade Required — Satta Ledger">
  <div class="flex items-center justify-center min-h-[60vh]">
    <div class="max-w-md w-full text-center space-y-6">
      <!-- Icon -->
      <div class="flex justify-center">
        <div class="flex h-20 w-20 items-center justify-center rounded-full bg-cyan-100 dark:bg-cyan-950/50">
          <svg class="h-10 w-10 text-cyan-600 dark:text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
        </div>
      </div>

      <!-- Heading -->
      <div>
        <h1 class="text-2xl font-bold text-navy-900 dark:text-navy-100">Upgrade Required</h1>
        <p class="text-sm text-slate-custom-600 dark:text-slate-custom-400 mt-2">
          Your current plan does not include <span class="font-semibold text-navy-900 dark:text-navy-100">{featureLabel}</span>.
          Upgrade your subscription to unlock this feature and more.
        </p>
      </div>

      <!-- Actions -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href="/dashboard"
          class="btn-secondary flex items-center gap-2"
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to Dashboard
        </a>
        <button
          id="upgrade-plan-btn"
          class="btn-primary flex items-center gap-2"
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
          </svg>
          Upgrade Plan
        </button>
      </div>

      <!-- Feature hint -->
      <p class="text-xs text-slate-custom-500 dark:text-slate-custom-400">
        Manage your subscription from your account settings on SattaBase.
      </p>
    </div>
  </div>
</DashboardLayout>

<script>
  const upgradeBtn = document.getElementById('upgrade-plan-btn');
  upgradeBtn?.addEventListener('click', async () => {
    try {
      const { redirectToBaseWithAuthCode } = await import('@/lib/auth');
      await redirectToBaseWithAuthCode('/dashboard/billing');
    } catch {
      const { redirectToBase } = await import('@/lib/auth');
      redirectToBase('/dashboard/billing');
    }
  });
</script>
