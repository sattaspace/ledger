---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import MarkdownViewer from "@/components/vue/MarkdownViewer.vue";
import fs from "node:fs";
import path from "node:path";

const docsPath = path.resolve("../../dev_docs.md");
const content = fs.existsSync(docsPath) ? fs.readFileSync(docsPath, "utf-8") : "";
---

<DashboardLayout title="Documentation — SattaBase" description="SattaBase development documentation.">
  <div class="mb-8">
    <h1 class="text-2xl font-bold tracking-tight text-foreground">Documentation</h1>
    <p class="mt-1 text-sm text-muted-foreground">
      Development documentation and API reference for the SattaBase platform.
    </p>
  </div>
  <MarkdownViewer client:only="vue" :content={content} />
</DashboardLayout>
