---
/**
 * Admin Refunds — /admin/refunds
 *
 * Review and process refund requests.
 * Full Vue component implementation pending.
 */
import AdminLayout from "@/layouts/AdminLayout.astro";
---

<AdminLayout
  title="Refunds — Admin — SattaBase"
  description="Review and process refund requests."
>
  <div id="admin-refunds-root">
    <!-- Page header -->
    <div class="mb-8">
      <h1 class="text-2xl font-bold text-foreground">Refunds</h1>
      <p class="mt-1 text-sm text-muted-foreground">
        Review and process refund requests.
      </p>
    </div>

    <!-- Placeholder card -->
    <div class="card flex flex-col items-center gap-4 p-10 text-center">
      <svg
        class="h-12 w-12 text-muted-foreground/30"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.5"
          d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"></path>
      </svg>
      <div>
        <p class="font-medium text-foreground">Refund Management</p>
        <p class="mt-1 text-sm text-muted-foreground">
          The full refund management interface is coming soon. Use the Django
          admin for now.
        </p>
      </div>
      <a
        href="/admin/django/billing/refund/"
        class="btn-secondary inline-flex items-center gap-2 mt-2"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg
          class="h-4 w-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
          ></path>
        </svg>
        Open Django Admin
      </a>
    </div>
  </div>
</AdminLayout>

<script>
  import { useAdminGuard } from "@/composables/useAdminGuard";
</script>
