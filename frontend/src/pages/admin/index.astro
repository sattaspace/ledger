---
/**
 * Admin Dashboard — Landing page for /admin route.
 *
 * Shows key metrics overview cards and quick links to admin sections.
 * Full dashboard implementation comes in Phase 10.3.
 */
import AdminLayout from "@/layouts/AdminLayout.astro";
---

<AdminLayout
  title="Admin Dashboard — SattaBase"
  description="SattaBase administration dashboard."
>
  <div id="admin-dashboard-root">
    <!-- Page header -->
    <div class="mb-8">
      <h1 class="text-2xl font-bold text-foreground">Admin Dashboard</h1>
      <p class="mt-1 text-sm text-muted-foreground">
        Monitor and manage your Sattabase platform.
      </p>
    </div>

    <!-- Quick links grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
      <a
        href="/admin/products"
        class="group flex flex-col rounded-xl border border-border bg-card p-5 transition-all hover:border-amber-300 hover:shadow-md dark:hover:border-amber-700"
      >
        <div class="flex items-center gap-3 mb-3">
          <div
            class="flex h-10 w-10 items-center justify-center rounded-lg bg-amber-100 dark:bg-amber-950 text-amber-600 dark:text-amber-400"
          >
            <svg
              class="h-5 w-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
              ></path>
            </svg>
          </div>
          <h3
            class="text-sm font-semibold text-foreground group-hover:text-amber-600 dark:group-hover:text-amber-400"
          >
            Products
          </h3>
        </div>
        <p class="text-xs text-muted-foreground">
          Manage products, plans, and access entries
        </p>
      </a>

      <a
        href="/admin/subscriptions"
        class="group flex flex-col rounded-xl border border-border bg-card p-5 transition-all hover:border-amber-300 hover:shadow-md dark:hover:border-amber-700"
      >
        <div class="flex items-center gap-3 mb-3">
          <div
            class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-100 dark:bg-blue-950 text-blue-600 dark:text-blue-400"
          >
            <svg
              class="h-5 w-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"
              ></path>
            </svg>
          </div>
          <h3
            class="text-sm font-semibold text-foreground group-hover:text-blue-600 dark:group-hover:text-blue-400"
          >
            Subscriptions
          </h3>
        </div>
        <p class="text-xs text-muted-foreground">
          View and manage all user subscriptions
        </p>
      </a>

      <a
        href="/admin/users"
        class="group flex flex-col rounded-xl border border-border bg-card p-5 transition-all hover:border-amber-300 hover:shadow-md dark:hover:border-amber-700"
      >
        <div class="flex items-center gap-3 mb-3">
          <div
            class="flex h-10 w-10 items-center justify-center rounded-lg bg-purple-100 dark:bg-purple-950 text-purple-600 dark:text-purple-400"
          >
            <svg
              class="h-5 w-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"
              ></path>
            </svg>
          </div>
          <h3
            class="text-sm font-semibold text-foreground group-hover:text-purple-600 dark:group-hover:text-purple-400"
          >
            Users
          </h3>
        </div>
        <p class="text-xs text-muted-foreground">
          Search users, view profiles, manage roles
        </p>
      </a>

      <a
        href="/admin/api-keys"
        class="group flex flex-col rounded-xl border border-border bg-card p-5 transition-all hover:border-amber-300 hover:shadow-md dark:hover:border-amber-700"
      >
        <div class="flex items-center gap-3 mb-3">
          <div
            class="flex h-10 w-10 items-center justify-center rounded-lg bg-green-100 dark:bg-green-950 text-green-600 dark:text-green-400"
          >
            <svg
              class="h-5 w-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z"
              ></path>
            </svg>
          </div>
          <h3
            class="text-sm font-semibold text-foreground group-hover:text-green-600 dark:group-hover:text-green-400"
          >
            API Keys
          </h3>
        </div>
        <p class="text-xs text-muted-foreground">
          Manage service-to-service credentials
        </p>
      </a>
    </div>

    <!-- Secondary links -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <a
        href="/admin/refunds"
        class="group flex items-center gap-3 rounded-xl border border-border bg-card p-4 transition-all hover:border-amber-300 hover:shadow-md dark:hover:border-amber-700"
      >
        <div
          class="flex h-9 w-9 items-center justify-center rounded-lg bg-orange-100 dark:bg-orange-950 text-orange-600 dark:text-orange-400"
        >
          <svg
            class="h-4 w-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"></path>
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-foreground">Refunds</h3>
          <p class="text-xs text-muted-foreground">
            Review and process refund requests
          </p>
        </div>
      </a>

      <a
        href="/admin/webhooks"
        class="group flex items-center gap-3 rounded-xl border border-border bg-card p-4 transition-all hover:border-amber-300 hover:shadow-md dark:hover:border-amber-700"
      >
        <div
          class="flex h-9 w-9 items-center justify-center rounded-lg bg-cyan-100 dark:bg-cyan-950 text-cyan-600 dark:text-cyan-400"
        >
          <svg
            class="h-4 w-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"
            ></path>
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-foreground">Webhooks</h3>
          <p class="text-xs text-muted-foreground">
            Monitor and retry webhook events
          </p>
        </div>
      </a>

      <a
        href="/admin/audit-log"
        class="group flex items-center gap-3 rounded-xl border border-border bg-card p-4 transition-all hover:border-amber-300 hover:shadow-md dark:hover:border-amber-700"
      >
        <div
          class="flex h-9 w-9 items-center justify-center rounded-lg bg-slate-100 dark:bg-slate-950 text-slate-600 dark:text-slate-400"
        >
          <svg
            class="h-4 w-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
            ></path>
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-foreground">Audit Log</h3>
          <p class="text-xs text-muted-foreground">
            Track admin actions and changes
          </p>
        </div>
      </a>
    </div>

    <!-- Placeholder for metrics (Phase 10.3) -->
    <div
      class="mt-8 rounded-xl border border-dashed border-border bg-card/50 p-8 text-center"
    >
      <svg
        class="mx-auto h-10 w-10 text-muted-foreground/30"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.5"
          d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
        ></path>
      </svg>
      <h3 class="mt-3 text-sm font-medium text-muted-foreground">
        Metrics Dashboard Coming Soon
      </h3>
      <p class="mt-1 text-xs text-muted-foreground/60">
        Key metrics, charts, and activity feed will be added in Phase 10.3
      </p>
    </div>
  </div>
</AdminLayout>

<script>
  import { useAdminGuard } from "@/composables/useAdminGuard";
</script>
