---
import BaseLayout from "@/layouts/BaseLayout.astro";

const currentYear = new Date().getFullYear();

const features = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z"/></svg>`,
    title: "Dashboard & Analytics",
    description: "Real-time financial overview with beautiful charts and insights to understand your money at a glance.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z"/></svg>`,
    title: "Expense Tracking",
    description: "Categorize and monitor every transaction. See exactly where your money goes each month.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 6.878V6a2.25 2.25 0 012.25-2.25h7.5A2.25 2.25 0 0118 6v.878m-12 0c.235-.083.487-.128.75-.128h10.5c.263 0 .515.045.75.128m-12 0A2.25 2.25 0 004.5 9v.878m13.5-3A2.25 2.25 0 0119.5 9v.878m0 0a2.246 2.246 0 00-.75-.128H5.25c-.263 0-.515.045-.75.128m15 0A2.25 2.25 0 0121 12v6a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 18v-6c0-.98.626-1.813 1.5-2.122"/></svg>`,
    title: "Budget Management",
    description: "Set spending limits by category and get alerts before you go over budget. Stay on track effortlessly.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0"/></svg>`,
    title: "Smart Notifications",
    description: "Timely reminders for bills, low balances, and unusual spending. Never miss a payment again.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3"/></svg>`,
    title: "Responsive Design",
    description: "Access your finances anywhere, anytime. Works beautifully on desktop, tablet, and mobile.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>`,
    title: "Secure by Default",
    description: "Your financial data is encrypted end-to-end. We take security seriously so you can rest easy.",
  },
];

const steps = [
  {
    number: "1",
    title: "Create Account",
    description: "Sign up in seconds with just your email. No credit card required to get started.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg>`,
  },
  {
    number: "2",
    title: "Connect Accounts",
    description: "Link your bank accounts and financial services for automatic transaction import.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m9.86-3.085a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244"/></svg>`,
  },
  {
    number: "3",
    title: "Start Tracking",
    description: "Watch your finances come to life. Set budgets, track goals, and build better habits.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
  },
];

const stats = [
  { value: "10K+", label: "Active Users" },
  { value: "$2M+", label: "Money Tracked" },
  { value: "99.9%", label: "Uptime" },
];

const footerLinks = {
  product: [
    { label: "Features", href: "#features" },
    { label: "Pricing", href: "#" },
    { label: "Roadmap", href: "#" },
  ],
  company: [
    { label: "About", href: "#" },
    { label: "Blog", href: "#" },
    { label: "Contact", href: "#" },
  ],
  legal: [
    { label: "Terms", href: "#" },
    { label: "Privacy", href: "#" },
  ],
};
---

<BaseLayout title="Satta Ledger — Personal Finance Made Simple" description="Track expenses, manage budgets, and take control of your finances. The modern personal finance tool for everyone.">
  <div class="min-h-screen flex flex-col">

    <!-- ========== Landing Nav ========== -->
    <nav class="sticky top-0 z-50 border-b border-border/60 bg-background/80 backdrop-blur-lg">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
        <!-- Brand -->
        <a href="/" class="flex items-center gap-2.5">
          <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-600 text-white font-bold text-base shadow-md shadow-brand-600/20">
            S
          </div>
          <span class="text-lg font-semibold text-foreground">Satta Ledger</span>
        </a>
        <!-- Actions -->
        <div class="flex items-center gap-2 sm:gap-3">
          <a href="/auth/login" class="btn-ghost text-sm px-3 sm:px-4 py-2">
            Sign In
          </a>
          <a href="/auth/register" class="btn-primary text-sm px-3 sm:px-4 py-2">
            Get Started
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
          </a>
        </div>
      </div>
    </nav>

    <main class="flex-1">

      <!-- ========== Hero Section ========== -->
      <section class="relative overflow-hidden">
        <!-- Background decoration -->
        <div class="pointer-events-none absolute inset-0 -z-10">
          <div class="absolute -top-40 -right-40 h-[500px] w-[500px] rounded-full bg-brand-500/5 dark:bg-brand-500/10 blur-3xl"></div>
          <div class="absolute -bottom-40 -left-40 h-[400px] w-[400px] rounded-full bg-brand-400/5 dark:bg-brand-400/8 blur-3xl"></div>
          <!-- Grid pattern -->
          <div class="absolute inset-0 bg-[linear-gradient(rgba(0,0,0,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(0,0,0,0.02)_1px,transparent_1px)] bg-[size:60px_60px] [mask-image:radial-gradient(ellipse_at_center,black_30%,transparent_70%)] dark:bg-[linear-gradient(rgba(255,255,255,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.03)_1px,transparent_1px)]"></div>
        </div>

        <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 pt-16 sm:pt-24 pb-16 sm:pb-20">
          <div class="grid gap-10 lg:grid-cols-2 lg:gap-12 items-center">
            <!-- Left: Copy -->
            <div class="max-w-xl">
              <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-brand-500/20 bg-brand-500/10 px-3 py-1 text-sm font-medium text-brand-700 dark:text-brand-400">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z"/></svg>
                Personal finance, simplified
              </div>
              <h1 class="text-4xl font-extrabold tracking-tight text-foreground sm:text-5xl lg:text-[3.4rem] leading-[1.1]">
                Take Control of{" "}
                <span class="bg-gradient-to-r from-brand-600 via-brand-500 to-emerald-500 bg-clip-text text-transparent dark:from-brand-400 dark:via-brand-300 dark:to-emerald-400">Your Finances</span>
              </h1>
              <p class="mt-5 text-lg leading-relaxed text-muted-foreground sm:text-xl">
                Track expenses, manage budgets, and build healthier financial habits. The all-in-one personal accounting tool that makes money management effortless.
              </p>
              <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:gap-4">
                <a href="/auth/register" class="btn-primary px-6 py-3 text-base shadow-lg shadow-brand-600/25 dark:shadow-brand-500/20">
                  Get Started Free
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
                </a>
                <a href="/auth/login" class="btn-ghost px-6 py-3 text-base">
                  Sign In
                </a>
              </div>
              <p class="mt-4 text-sm text-muted-foreground">
                No credit card required &middot; Free forever plan available
              </p>
            </div>

            <!-- Right: Dashboard Mockup -->
            <div class="relative mx-auto w-full max-w-lg lg:max-w-none">
              <div class="card rounded-2xl p-1 shadow-2xl shadow-brand-900/10 dark:shadow-brand-500/5">
                <div class="rounded-xl bg-muted/50 p-4 sm:p-5">
                  <!-- Mockup header bar -->
                  <div class="flex items-center justify-between mb-4">
                    <div class="flex items-center gap-2">
                      <div class="h-8 w-8 rounded-lg bg-brand-600 text-white flex items-center justify-center text-xs font-bold">S</div>
                      <div>
                        <div class="h-3 w-20 rounded bg-foreground/15"></div>
                      </div>
                    </div>
                    <div class="flex gap-1.5">
                      <div class="h-7 w-7 rounded-md bg-muted-foreground/10"></div>
                      <div class="h-7 w-7 rounded-md bg-muted-foreground/10"></div>
                    </div>
                  </div>
                  <!-- Stats row -->
                  <div class="grid grid-cols-3 gap-3 mb-4">
                    <div class="rounded-lg bg-background p-3 border border-border">
                      <div class="h-2.5 w-12 rounded bg-muted-foreground/20 mb-2"></div>
                      <div class="h-4 w-16 rounded bg-brand-500/20"></div>
                    </div>
                    <div class="rounded-lg bg-background p-3 border border-border">
                      <div class="h-2.5 w-10 rounded bg-muted-foreground/20 mb-2"></div>
                      <div class="h-4 w-14 rounded bg-emerald-500/20"></div>
                    </div>
                    <div class="rounded-lg bg-background p-3 border border-border">
                      <div class="h-2.5 w-14 rounded bg-muted-foreground/20 mb-2"></div>
                      <div class="h-4 w-12 rounded bg-foreground/10"></div>
                    </div>
                  </div>
                  <!-- Chart placeholder -->
                  <div class="rounded-lg bg-background p-4 border border-border">
                    <div class="h-2.5 w-24 rounded bg-muted-foreground/15 mb-3"></div>
                    <div class="flex items-end gap-2 h-24">
                      <div class="flex-1 rounded-sm bg-brand-500/20 h-[40%]"></div>
                      <div class="flex-1 rounded-sm bg-brand-500/25 h-[60%]"></div>
                      <div class="flex-1 rounded-sm bg-brand-500/30 h-[45%]"></div>
                      <div class="flex-1 rounded-sm bg-brand-500/40 h-[80%]"></div>
                      <div class="flex-1 rounded-sm bg-brand-500/35 h-[55%]"></div>
                      <div class="flex-1 rounded-sm bg-brand-500/50 h-[90%]"></div>
                      <div class="flex-1 rounded-sm bg-brand-600/60 h-[70%]"></div>
                    </div>
                  </div>
                  <!-- Recent transactions -->
                  <div class="mt-3 rounded-lg bg-background p-4 border border-border">
                    <div class="h-2.5 w-28 rounded bg-muted-foreground/15 mb-3"></div>
                    <div class="space-y-2.5">
                      <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                          <div class="h-7 w-7 rounded-md bg-brand-100 dark:bg-brand-900/40"></div>
                          <div class="h-2.5 w-24 rounded bg-foreground/10"></div>
                        </div>
                        <div class="h-2.5 w-12 rounded bg-muted-foreground/15"></div>
                      </div>
                      <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                          <div class="h-7 w-7 rounded-md bg-muted-foreground/10"></div>
                          <div class="h-2.5 w-20 rounded bg-foreground/10"></div>
                        </div>
                        <div class="h-2.5 w-14 rounded bg-muted-foreground/15"></div>
                      </div>
                      <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                          <div class="h-7 w-7 rounded-md bg-emerald-100 dark:bg-emerald-900/40"></div>
                          <div class="h-2.5 w-28 rounded bg-foreground/10"></div>
                        </div>
                        <div class="h-2.5 w-10 rounded bg-muted-foreground/15"></div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <!-- Floating badge -->
              <div class="absolute -bottom-3 -left-3 sm:-bottom-4 sm:-left-4 card rounded-xl px-3 py-2.5 shadow-lg border-brand-500/20 flex items-center gap-2">
                <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand-500/15 text-brand-600 dark:text-brand-400">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941"/></svg>
                </div>
                <div>
                  <p class="text-xs font-semibold text-foreground">Budget On Track</p>
                  <p class="text-[11px] text-muted-foreground">68% of monthly goal</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ========== Features Section ========== -->
      <section id="features" class="py-20 sm:py-28 bg-muted/40 border-y border-border/50">
        <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
          <!-- Section header -->
          <div class="mx-auto max-w-2xl text-center mb-14 sm:mb-16">
            <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
              Everything you need to{" "}
              <span class="bg-gradient-to-r from-brand-600 to-emerald-500 bg-clip-text text-transparent dark:from-brand-400 dark:to-emerald-400">manage your money</span>
            </h2>
            <p class="mt-4 text-lg text-muted-foreground leading-relaxed">
              Powerful features designed to give you complete visibility and control over your personal finances.
            </p>
          </div>

          <!-- Feature grid -->
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {features.map((feature) => (
              <div class="card group relative overflow-hidden rounded-xl p-6 transition-all duration-300 hover:shadow-lg hover:shadow-brand-900/5 dark:hover:shadow-brand-500/5 hover:border-brand-500/20 hover:-translate-y-0.5">
                <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-brand-500/10 text-brand-600 dark:text-brand-400 transition-colors group-hover:bg-brand-500/15 mb-4">
                  <Fragment set:html={feature.icon} />
                </div>
                <h3 class="text-base font-semibold text-foreground mb-2">{feature.title}</h3>
                <p class="text-sm leading-relaxed text-muted-foreground">{feature.description}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ========== How It Works Section ========== -->
      <section class="py-20 sm:py-28">
        <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
          <div class="mx-auto max-w-2xl text-center mb-14 sm:mb-16">
            <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
              Get started in minutes
            </h2>
            <p class="mt-4 text-lg text-muted-foreground leading-relaxed">
              Three simple steps to financial clarity. No complicated setup required.
            </p>
          </div>

          <div class="relative mx-auto max-w-4xl">
            <!-- Connector line (hidden on mobile) -->
            <div class="absolute top-16 left-0 right-0 hidden h-0.5 bg-gradient-to-r from-transparent via-brand-500/20 to-transparent sm:block" aria-hidden="true"></div>

            <div class="grid gap-10 sm:gap-8 sm:grid-cols-3">
              {steps.map((step) => (
                <div class="relative flex flex-col items-center text-center">
                  <!-- Step circle -->
                  <div class="relative z-10 flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-600 text-white shadow-lg shadow-brand-600/25 mb-5">
                    <Fragment set:html={step.icon} />
                  </div>
                  <!-- Step number badge -->
                  <div class="absolute -top-2 -right-2 z-20 flex h-6 w-6 items-center justify-center rounded-full bg-brand-500 text-white text-xs font-bold shadow-md">
                    {step.number}
                  </div>
                  <h3 class="text-lg font-semibold text-foreground mb-2">{step.title}</h3>
                  <p class="text-sm leading-relaxed text-muted-foreground max-w-xs">{step.description}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- ========== Stats / Social Proof Section ========== -->
      <section class="py-16 sm:py-20 bg-brand-600 dark:bg-brand-700">
        <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
          <div class="grid gap-8 sm:gap-12 sm:grid-cols-3 text-center">
            {stats.map((stat) => (
              <div>
                <div class="text-3xl font-extrabold text-white sm:text-4xl">{stat.value}</div>
                <div class="mt-1.5 text-sm font-medium text-brand-100/80">{stat.label}</div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ========== CTA Section ========== -->
      <section class="py-20 sm:py-28">
        <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
          <div class="relative mx-auto max-w-2xl text-center">
            <!-- Background glow -->
            <div class="pointer-events-none absolute inset-0 -z-10">
              <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 h-[300px] w-[400px] rounded-full bg-brand-500/5 dark:bg-brand-500/10 blur-3xl"></div>
            </div>

            <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
              Ready to take control?
            </h2>
            <p class="mt-4 text-lg text-muted-foreground leading-relaxed">
              Join thousands of users who have already transformed their financial habits. Start your journey today.
            </p>
            <div class="mt-8 flex flex-col items-center gap-3">
              <a href="/auth/register" class="btn-primary px-8 py-3.5 text-base shadow-lg shadow-brand-600/25 dark:shadow-brand-500/20">
                Get Started Free
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
              </a>
              <p class="text-sm text-muted-foreground">
                No credit card required &middot; Free forever plan available
              </p>
            </div>
          </div>
        </div>
      </section>

    </main>

    <!-- ========== Footer ========== -->
    <footer class="border-t border-border bg-muted/30 mt-auto">
