---
import AuthLayout from "@/layouts/AuthLayout.astro";
import ForgotPasswordForm from "@/components/vue/ForgotPasswordForm.vue";
---

<AuthLayout title="Reset Password — Satta Ledger" description="Reset your password with the verification code from your email.">
  <!-- OTP-based password reset uses a single-page flow in ForgotPasswordForm -->
  <!-- This page redirects here for anyone with the old /auth/reset-password bookmark -->
  <div class="text-center mb-4">
    <p class="text-sm text-[var(--color-muted-foreground)]">
      Password reset now uses a verification code. Please enter your email below.
    </p>
  </div>
  <ForgotPasswordForm client:only="vue" />
</AuthLayout>
