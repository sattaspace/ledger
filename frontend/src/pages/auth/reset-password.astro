---
import AuthLayout from "@/layouts/AuthLayout.astro";
import ResetPasswordForm from "@/components/vue/ResetPasswordForm.vue";

// Token can come from ?token= UUID query param
const token = Astro.url.searchParams.get("token") || undefined;
---

<AuthLayout title="Reset Password — Satta Ledger" description="Reset your password with the token from your email.">
  <ResetPasswordForm client:only="vue" token={token} />
</AuthLayout>