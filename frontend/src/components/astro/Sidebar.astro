---
interface NavItem {
  label: string;
  href: string;
  icon: string;
  disabled?: boolean;
  badge?: string;
}

interface NavSection {
  title: string;
  items: NavItem[];
}

const mainNav: NavItem[] = [
  { label: "Dashboard", href: "/dashboard", icon: "dashboard" },
  { label: "Profile", href: "/dashboard/profile", icon: "user" },
  { label: "Settings", href: "/dashboard/settings", icon: "settings" },
];

const billingNav: NavSection = {
  title: "Billing",
  items: [
    { label: "Overview", href: "/dashboard/billing", icon: "billing" },
    // INAV-01 Fix: Link to billing overview instead of hardcoded product slug.
    // The overview page lists all available products dynamically.
    { label: "Plans", href: "/dashboard/billing", icon: "plans", disabled: true, badge: "Coming Soon" },
  ],
};

const financeNav: NavSection = {
  title: "Finance",
  items: [
    { label: "Transactions", href: "#", icon: "transactions", disabled: true, badge: "Soon" },
    { label: "Accounts", href: "#", icon: "accounts", disabled: true, badge: "Soon" },
    { label: "Budgets", href: "#", icon: "budgets", disabled: true, badge: "Soon" },
    { label: "Reports", href: "#", icon: "reports", disabled: true, badge: "Soon" },
  ],
};

const currentPath = Astro.url.pathname;
---

<div class="flex h-full flex-col">
  <!-- Logo -->
  <div class="flex h-16 items-center gap-3 border-b border-border px-6">
    <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-600 text-white font-bold text-sm shadow-md shadow-brand-600/20">
      S
    </div>
    <span class="text-lg font-bold tracking-tight">Satta Ledger</span>
  </div>

  <!-- Main Navigation -->
  <nav class="flex-1 space-y-1 overflow-y-auto px-3 py-4" aria-label="Main navigation">
    <!-- Section label -->
    <p class="mb-2 px-3 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground/70">
      General
    </p>

    {mainNav.map((item) => {
      const isActive = currentPath === item.href ||
        (item.href !== "/dashboard" && currentPath.startsWith(item.href));
      return (
        <a
          href={item.href}
          class:list={[
            "group relative flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-all duration-150",
            isActive
              ? "bg-brand-50 text-brand-700 dark:bg-brand-950 dark:text-brand-400"
              : "text-muted-foreground hover:bg-accent hover:text-foreground",
          ]}
        >
          {/* Active indicator — left border bar */}
          {isActive && (
            <span class="absolute left-0 top-1/2 -translate-y-1/2 h-6 w-[3px] rounded-r-full bg-brand-600 dark:bg-brand-500" />
          )}

          {item.icon === "dashboard" && (
            <svg class="h-5 w-5 shrink-0 transition-transform duration-150 group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v5a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM14 5a1 1 0 011-1h4a1 1 0 011 1v2a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1v-4zM14 12a1 1 0 011-1h4a1 1 0 011 1v7a1 1 0 01-1 1h-4a1 1 0 01-1-1v-7z" />
            </svg>
          )}
          {item.icon === "user" && (
            <svg class="h-5 w-5 shrink-0 transition-transform duration-150 group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          )}
          {item.icon === "settings" && (
            <svg class="h-5 w-5 shrink-0 transition-transform duration-150 group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          )}
          {item.label}
        </a>
      );
    })}

    <!-- Divider -->
    <div class="my-4 border-t border-border"></div>

    <!-- Billing section -->
    <p class="mb-2 px-3 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground/70">
      {billingNav.title}
    </p>

    {billingNav.items.map((item) => {
      const isActive = currentPath === item.href ||
        (item.href !== "/dashboard/billing" && currentPath.startsWith(item.href));
      return (
        <a
          href={item.disabled ? undefined : item.href}
          class:list=[
            "group relative flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-all duration-150",
            isActive
              ? "bg-brand-50 text-brand-700 dark:bg-brand-950 dark:text-brand-400"
              : "text-muted-foreground hover:bg-accent hover:text-foreground",
          ]}
          {...(item.disabled ? { "aria-disabled": "true", tabindex: "-1" } : {})}
        >
          {isActive && (
            <span class="absolute left-0 top-1/2 -translate-y-1/2 h-6 w-[3px] rounded-r-full bg-brand-600 dark:bg-brand-500" />
          )}
          {item.icon === "billing" && (
            <svg class="h-5 w-5 shrink-0 transition-transform duration-150 group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
            </svg>
          )}
          {item.icon === "plans" && (
            <svg class="h-5 w-5 shrink-0 transition-transform duration-150 group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
            </svg>
          )}
          {item.label}
        </a>
      );
    })}

    <!-- Divider -->
    <div class="my-4 border-t border-border"></div>

    <!-- Finance section -->
    <p class="mb-2 px-3 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground/70">
      {financeNav.title}
    </p>

    {financeNav.items.map((item) => (
      <a
        href={item.disabled ? undefined : item.href}
        class:list={[
          "group relative flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-all duration-150",
          item.disabled
            ? "cursor-not-allowed text-muted-foreground/50 opacity-60"
            : "text-muted-foreground hover:bg-accent hover:text-foreground",
        ]}
        {...(item.disabled ? { "aria-disabled": "true", tabindex: "-1" } : {})}
      >
        {/* Icon */}
        {item.icon === "transactions" && (
          <svg class="h-5 w-5 shrink-0 transition-transform duration-150 group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" />
          </svg>
        )}
        {item.icon === "accounts" && (
          <svg class="h-5 w-5 shrink-0 transition-transform duration-150 group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
          </svg>
        )}
        {item.icon === "budgets" && (
          <svg class="h-5 w-5 shrink-0 transition-transform duration-150 group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
        )}
        {item.icon === "reports" && (
          <svg class="h-5 w-5 shrink-0 transition-transform duration-150 group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        )}

        {item.label}

        {/* Badge */}
        {item.badge && (
          <span class="ml-auto inline-flex items-center rounded-full bg-muted px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-muted-foreground">
            {item.badge}
          </span>
        )}
      </a>
    ))}
  </nav>

  <!-- Bottom section -->
  <div class="border-t border-border">
    <!-- Sign out -->
    <a
      href="#"
      class="flex items-center gap-3 px-6 py-3 text-sm font-medium text-muted-foreground transition-colors hover:bg-destructive/10 hover:text-destructive"
      id="sidebar-sign-out"
      aria-label="Sign out"
    >
      <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
      </svg>
      Sign out
    </a>

    <!-- User info -->
    <div class="px-4 py-3">
      <div id="sidebar-user-info" class="flex items-center gap-3">
        <div class="flex h-8 w-8 items-center justify-center rounded-full bg-muted text-sm font-medium shrink-0">
          ?
        </div>
        <div class="flex-1 min-w-0">
          <p class="truncate text-sm font-medium" id="sidebar-user-name">Loading...</p>
          <p class="truncate text-xs text-muted-foreground" id="sidebar-user-email">...</p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const signOutBtn = document.getElementById("sidebar-sign-out");
    signOutBtn?.addEventListener("click", async (e) => {
      e.preventDefault();
      try {
        const { logout } = await import("@/lib/auth");
        await logout();
      } catch {
        localStorage.removeItem("access_token");
        localStorage.removeItem("refresh_token");
        window.location.href = "/auth/login";
      }
    });
  });
</script>
