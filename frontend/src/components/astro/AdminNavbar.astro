---
/**
 * AdminNavbar — Top navigation bar for the /admin/* section.
 *
 * Follows the same pattern as Navbar.astro but with admin-specific elements:
 *   - "Sattabase Admin" breadcrumb
 *   - Staff badge indicator
 *   - Link to user-facing dashboard
 *   - Link to Django admin
 *   - Dark mode toggle
 *   - User menu with sign out
 */
---

<header class="z-40 bg-card/80 backdrop-blur-md">
  <div class="flex h-16 items-center justify-between px-4 md:px-6">
    <!-- Left: Mobile menu + Breadcrumb -->
    <div class="flex items-center gap-4">
      <!-- Mobile menu button -->
      <button
        type="button"
        class="lg:hidden inline-flex items-center justify-center rounded-lg p-2 text-muted-foreground hover:bg-accent hover:text-foreground focus-ring transition-colors"
        id="admin-mobile-menu-toggle"
        aria-label="Toggle admin sidebar menu"
        aria-expanded="false"
      >
        <svg
          class="h-5 w-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>

      <!-- Mobile logo -->
      <div class="flex items-center gap-2 lg:hidden">
        <div
          class="flex h-8 w-8 items-center justify-center rounded-lg bg-amber-600 text-white font-bold text-xs shadow-sm"
        >
          A
        </div>
        <span class="font-semibold text-sm">Admin</span>
      </div>

      <!-- Desktop breadcrumb -->
      <nav class="hidden lg:block" aria-label="Admin breadcrumb">
        <ol class="flex items-center gap-1.5 text-sm text-muted-foreground">
          <li class="flex items-center gap-1.5">
            <a
              href="/admin"
              class="transition-colors hover:text-foreground font-medium text-amber-600 dark:text-amber-400"
              >Admin</a
            >
          </li>
        </ol>
      </nav>
    </div>

    <!-- Right: Actions -->
    <div class="flex items-center gap-2">
      <!-- Back to dashboard link -->
      <a
        href="/dashboard"
        class="hidden sm:inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-sm font-medium text-muted-foreground hover:bg-accent hover:text-foreground transition-colors"
        title="Back to user dashboard"
      >
        <svg
          class="h-4 w-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M11 17l-5-5m0 0l5-5m-5 5h12"></path>
        </svg>
        <span class="hidden md:inline">Dashboard</span>
      </a>

      <!-- Django admin link -->
      <a
        href="/admin/django/"
        class="hidden sm:inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-sm font-medium text-muted-foreground/60 hover:bg-accent hover:text-foreground transition-colors"
        target="_blank"
        rel="noopener noreferrer"
        title="Django Admin"
      >
        <svg
          class="h-4 w-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
          ></path>
        </svg>
        <span class="hidden md:inline">Django</span>
      </a>

      <!-- Divider -->
      <div class="hidden h-6 w-px bg-border sm:block"></div>

      <!-- Dark mode toggle -->
      <button
        type="button"
        class="inline-flex items-center justify-center rounded-lg p-2 text-muted-foreground hover:bg-accent hover:text-foreground focus-ring transition-colors"
        id="admin-dark-mode-toggle"
        aria-label="Toggle dark mode"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg
          class="h-5 w-5 hidden dark:block"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
          ></path>
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg
          class="h-5 w-5 block dark:hidden"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
          ></path>
        </svg>
      </button>

      <!-- Divider -->
      <div class="hidden h-6 w-px bg-border sm:block"></div>

      <!-- User dropdown -->
      <div class="relative" id="admin-user-dropdown-wrapper">
        <button
          type="button"
          class="flex items-center gap-2 rounded-lg px-2 py-1.5 text-left transition-colors hover:bg-accent focus-ring"
          id="admin-user-menu-toggle"
          aria-label="Admin user menu"
          aria-expanded="false"
        >
          <div
            class="flex h-8 w-8 items-center justify-center rounded-full bg-gradient-to-br from-amber-500 to-amber-700 text-white text-xs font-bold"
          >
            ?
          </div>
          <div class="hidden md:block">
            <span
              class="text-sm font-medium truncate max-w-32 block"
              id="admin-navbar-user-name">Loading...</span
            >
            <span
              class="text-[10px] font-semibold uppercase tracking-wide text-amber-600 dark:text-amber-400"
              id="admin-navbar-user-role">Staff</span
            >
          </div>
          <!-- Chevron -->
          <svg
            class="hidden md:block h-4 w-4 text-muted-foreground"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>

        <!-- User dropdown menu -->
        <div
          class="hidden absolute right-0 top-full mt-2 w-56 rounded-xl border border-border bg-card shadow-lg animate-scale-in origin-top-right"
          id="admin-user-dropdown"
          role="menu"
        >
          <div class="px-4 py-3 border-b border-border">
            <p
              class="text-sm font-medium truncate"
              id="admin-user-dropdown-name"
            >
              Loading...
            </p>
            <p class="flex items-center gap-2 mt-0.5">
              <span
                class="text-xs text-muted-foreground truncate"
                id="admin-user-dropdown-email">...</span
              >
              <span
                class="ml-auto inline-flex items-center rounded-md border border-amber-200 dark:border-amber-800 bg-amber-50 dark:bg-amber-950/40 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-amber-700 dark:text-amber-400"
                id="admin-dropdown-role-badge"
              >
                Staff
              </span>
            </p>
          </div>
          <div class="py-1">
            <a
              href="/dashboard"
              class="flex items-center gap-3 px-4 py-2.5 text-sm text-foreground transition-colors hover:bg-accent"
              role="menuitem"
            >
              <svg
                class="h-4 w-4 text-muted-foreground"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M11 17l-5-5m0 0l5-5m-5 5h12"></path>
              </svg>
              User Dashboard
            </a>
            <a
              href="/admin/django/"
              class="flex items-center gap-3 px-4 py-2.5 text-sm text-foreground transition-colors hover:bg-accent"
              role="menuitem"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg
                class="h-4 w-4 text-muted-foreground"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                ></path>
              </svg>
              Django Admin
            </a>
          </div>
          <div class="border-t border-border py-1">
            <button
              type="button"
              class="flex w-full items-center gap-3 px-4 py-2.5 text-sm text-destructive transition-colors hover:bg-destructive/10"
              role="menuitem"
              id="admin-navbar-sign-out"
            >
              <svg
                class="h-4 w-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
                ></path>
              </svg>
              Sign out
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  // ── Admin Navbar initialization ──
  // Same pattern as Navbar.astro: use window-level flags to prevent
  // duplicate initialization across View Transitions, and wait for
  // auth init before populating user info.

  const SB_ADMIN_NAVBAR_INIT = "__sb_admin_navbar_init";

  function isAdminNavbarInitialized(): boolean {
    return (
      typeof window !== "undefined" &&
      (window as any)[SB_ADMIN_NAVBAR_INIT] === true
    );
  }

  function markAdminNavbarInitialized(): void {
    if (typeof window !== "undefined") {
      (window as any)[SB_ADMIN_NAVBAR_INIT] = true;
    }
  }

  if (!isAdminNavbarInitialized()) {
    markAdminNavbarInitialized();

    const mobileMenuToggle = document.getElementById(
      "admin-mobile-menu-toggle",
    );
    const darkModeToggle = document.getElementById("admin-dark-mode-toggle");
    const userMenuToggle = document.getElementById("admin-user-menu-toggle");
    const userDropdown = document.getElementById("admin-user-dropdown");
    const signOutBtn = document.getElementById("admin-navbar-sign-out");

    // ── Mobile sidebar toggle → dispatch custom event ──
    mobileMenuToggle?.addEventListener("click", () => {
      document.dispatchEvent(
        new CustomEvent("toggle-admin-mobile-sidebar", {
          detail: { open: true },
        }),
      );
      mobileMenuToggle.setAttribute("aria-expanded", "true");
    });

    // ── Dark mode toggle ──
    darkModeToggle?.addEventListener("click", () => {
      const html = document.documentElement;
      const isDark = html.classList.toggle("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");

      const meta = document.querySelector('meta[name="theme-color"]');
      if (meta) {
        meta.setAttribute("content", isDark ? "#0a0a0a" : "#d97706");
      }
    });

    // ── User dropdown toggle ──
    userMenuToggle?.addEventListener("click", () => {
      const isHidden = userDropdown?.classList.contains("hidden");
      closeDropdown();
      if (isHidden) {
        userDropdown?.classList.remove("hidden");
        userMenuToggle.setAttribute("aria-expanded", "true");
      } else {
        userMenuToggle.setAttribute("aria-expanded", "false");
      }
    });

    // ── Sign out ──
    signOutBtn?.addEventListener("click", async () => {
      try {
        const { logout } = await import("@/lib/auth");
        await logout();
      } catch {
        const { authHelpers } = await import("@/lib/api");
        authHelpers.clearAuth();
        // VUE 3 CONVENTION: Use navigate() instead of window.location.href
        try {
          const { navigate } = await import("astro:transitions/client");
          navigate("/auth/login", { history: "replace" });
        } catch {
          window.location.href = "/auth/login";
        }
      }
    });

    // ── Close dropdown on outside click ──
    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      const wrapper = document.getElementById("admin-user-dropdown-wrapper");
      if (wrapper && !wrapper.contains(target)) {
        closeDropdown();
      }
    });

    // ── Close dropdown on Escape ──
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeDropdown();
    });

    function closeDropdown() {
      userDropdown?.classList.add("hidden");
      userMenuToggle?.setAttribute("aria-expanded", "false");
    }

    // ── Populate user info ──
    // API-1 FIX: Use cached user from useAuth() shared state instead of
    // making a separate GET /users/me call. The user data is already fetched
    // by useAuth().initAuth() in the AdminGuard/SessionGuard, so we can read
    // it from the window-level shared state without another API call.
    // This saves 1 duplicate /users/me call per admin page load.
    // AUTH-14 FIX: Added fallback to /users/me when fetchUser() (which calls
    // /billing/auth/me) fails. Also added retry logic and cross-component
    // sync via custom events.
    async function populateAdminUserInfo() {
      try {
        // Wait for auth initialization to complete before fetching user info.
        // Without this, fetchUser() fires before the access token is restored
        // from the cookie-based refresh, causing a 401.
        const { authHelpers } = await import("@/lib/api");
        const maxWait = 8000; // 8 second timeout — generous for slow connections
        const start = Date.now();
        while (!authHelpers.isAuthReady() && Date.now() - start < maxWait) {
          await new Promise((r) => setTimeout(r, 150));
        }

        // If auth still not ready, schedule retry
        if (!authHelpers.isAuthReady()) {
          const navbarCache = (window as any).__sb_admin_navbar || {};
          if (!navbarCache.userInfoRetries || navbarCache.userInfoRetries < 3) {
            (window as any).__sb_admin_navbar = {
              ...navbarCache,
              userInfoRetries: (navbarCache.userInfoRetries || 0) + 1,
            };
            setTimeout(() => populateAdminUserInfo(), 2000);
          }
          return;
        }

        // API-1 FIX: Read from useAuth's window-level shared state
        const win = window as any;
        const sharedAuth = win.__sb_auth_composable;
        let user: {
          display_name?: string;
          email: string;
          role: string;
          is_staff: boolean;
          first_name?: string;
          last_name?: string;
        } | null = null;

        // Path 1: Read from shared Vue reactive state (already cached by AdminGuard/SessionGuard)
        if (sharedAuth?.userRef?.value) {
          // User data already cached by useAuth() — use it directly
          user = sharedAuth.userRef.value;
        }

        // Path 2: Fetch via useAuth (deduplicated)
        if (!user) {
          try {
            const { useAuth } = await import("@/composables/useAuth");
            const { fetchUser } = useAuth();
            const fetchedUser = await fetchUser();
            if (fetchedUser) {
              user = fetchedUser as any;
            }
          } catch {
            // /billing/auth/me failed — try fallback below
          }
        }

        // Path 3: Fallback to /users/me directly if fetchUser failed
        if (!user) {
          try {
            const { apiClient } = await import("@/lib/api");
            const userData = await apiClient.get<{
              display_name?: string;
              email: string;
              role: string;
              is_staff: boolean;
              first_name?: string;
              last_name?: string;
            }>("/users/me");
            if (userData) {
              user = userData;
            }
          } catch {
            // Both paths failed — user truly not authenticated
          }
        }

        if (!user) {
          // All fetch paths failed — schedule retry
          const navbarCache = (window as any).__sb_admin_navbar || {};
          if (!navbarCache.userInfoRetries || navbarCache.userInfoRetries < 3) {
            (window as any).__sb_admin_navbar = {
              ...navbarCache,
              userInfoRetries: (navbarCache.userInfoRetries || 0) + 1,
            };
            setTimeout(() => populateAdminUserInfo(), 3000);
          }
          return;
        }

        const displayName =
          user.display_name ||
          (user.first_name && user.last_name
            ? `${user.first_name} ${user.last_name}`
            : null) ||
          user.email;
        const roleLabel = user.is_staff
          ? "Super Admin"
          : user.role === "owner"
            ? "Owner"
            : user.role === "admin"
              ? "Admin"
              : "Staff";

        const initials = displayName
          .split(" ")
          .map((n: string) => n[0])
          .join("")
          .slice(0, 2)
          .toUpperCase();

        // Update all name/role/avatar elements
        const nameEls = [
          document.getElementById("admin-navbar-user-name"),
          document.getElementById("admin-user-dropdown-name"),
        ];
        nameEls.forEach((el) => {
          if (el) el.textContent = displayName;
        });

        const emailEl = document.getElementById("admin-user-dropdown-email");
        if (emailEl) emailEl.textContent = user.email;

        const roleEls = [
          document.getElementById("admin-navbar-user-role"),
          document.getElementById("admin-dropdown-role-badge"),
        ];
        roleEls.forEach((el) => {
          if (el) el.textContent = roleLabel;
        });

        // Update avatar initials in dropdown
        const avatarEl = document.querySelector(
          "#admin-user-menu-toggle .rounded-full",
        );
        if (avatarEl) avatarEl.textContent = initials;

        // Also update admin sidebar user name
        const sidebarNameEl = document.getElementById(
          "admin-sidebar-user-name",
        );
        if (sidebarNameEl) sidebarNameEl.textContent = displayName;
        const sidebarAvatarEl = document.getElementById(
          "admin-sidebar-user-avatar",
        );
        if (sidebarAvatarEl) sidebarAvatarEl.textContent = initials;
        const sidebarRoleEl = document.getElementById(
          "admin-sidebar-user-role",
        );
        if (sidebarRoleEl) sidebarRoleEl.textContent = roleLabel;

        // Mark as loaded
        (window as any).__sb_admin_navbar = {
          ...(window as any).__sb_admin_navbar,
          userInfoLoaded: true,
        };

        // Dispatch event so other components (AdminSidebar) can update too
        document.dispatchEvent(
          new CustomEvent("sb:admin-user-info-loaded", {
            detail: { displayName, initials, roleLabel, email: user.email },
          }),
        );
      } catch {
        // Not authenticated — schedule retry
        const navbarCache = (window as any).__sb_admin_navbar || {};
        if (!navbarCache.userInfoRetries || navbarCache.userInfoRetries < 3) {
          (window as any).__sb_admin_navbar = {
            ...navbarCache,
            userInfoRetries: (navbarCache.userInfoRetries || 0) + 1,
          };
          setTimeout(() => populateAdminUserInfo(), 3000);
        }
      }
    }

    populateAdminUserInfo();

    // Re-populate user info after View Transitions.
    document.addEventListener("astro:page-load", () => {
      const navbarCache = (window as any).__sb_admin_navbar || {};
      if (navbarCache.userInfoLoaded) {
        // Re-apply cached user data from shared auth state
        const win = window as any;
        const userRef = win.__sb_auth_composable?.userRef;
        if (userRef?.value) {
          const user = userRef.value;
          const displayName = user.display_name || user.email;
          const sidebarNameEl = document.getElementById(
            "admin-sidebar-user-name",
          );
          if (sidebarNameEl) sidebarNameEl.textContent = displayName;
          // Re-apply navbar elements too
          const navbarNameEl = document.getElementById(
            "admin-navbar-user-name",
          );
          if (navbarNameEl) navbarNameEl.textContent = displayName;
          const dropdownNameEl = document.getElementById(
            "admin-user-dropdown-name",
          );
          if (dropdownNameEl) dropdownNameEl.textContent = displayName;
          // Update avatar/role too
          const initials = displayName
            .split(" ")
            .map((n: string) => n[0])
            .join("")
            .slice(0, 2)
            .toUpperCase();
          const avatarEl = document.querySelector(
            "#admin-user-menu-toggle .rounded-full",
          );
          if (avatarEl) avatarEl.textContent = initials;
          const sidebarAvatarEl = document.getElementById(
            "admin-sidebar-user-avatar",
          );
          if (sidebarAvatarEl) sidebarAvatarEl.textContent = initials;
          const roleLabel = user.is_staff
            ? "Super Admin"
            : user.role === "owner"
              ? "Owner"
              : user.role === "admin"
                ? "Admin"
                : "Staff";
          const navbarRoleEl = document.getElementById(
            "admin-navbar-user-role",
          );
          if (navbarRoleEl) navbarRoleEl.textContent = roleLabel;
          const dropdownRoleEl = document.getElementById(
            "admin-dropdown-role-badge",
          );
          if (dropdownRoleEl) dropdownRoleEl.textContent = roleLabel;
          const sidebarRoleEl = document.getElementById(
            "admin-sidebar-user-role",
          );
          if (sidebarRoleEl) sidebarRoleEl.textContent = roleLabel;
        }
      } else {
        // Reset retry count and try again
        (window as any).__sb_admin_navbar = {
          ...navbarCache,
          userInfoRetries: 0,
        };
        populateAdminUserInfo();
      }
    });

    // Listen for user info loaded by AdminSidebar (cross-component sync)
    document.addEventListener("sb:admin-user-info-loaded", ((
      e: CustomEvent,
    ) => {
      const { displayName, initials, roleLabel, email } = e.detail;
      // Update navbar elements
      const nameEls = [
        document.getElementById("admin-navbar-user-name"),
        document.getElementById("admin-user-dropdown-name"),
      ];
      nameEls.forEach((el) => {
        if (el) el.textContent = displayName;
      });
      const emailEl = document.getElementById("admin-user-dropdown-email");
      if (emailEl) emailEl.textContent = email;
      const roleEls = [
        document.getElementById("admin-navbar-user-role"),
        document.getElementById("admin-dropdown-role-badge"),
      ];
      roleEls.forEach((el) => {
        if (el) el.textContent = roleLabel;
      });
      const avatarEl = document.querySelector(
        "#admin-user-menu-toggle .rounded-full",
      );
      if (avatarEl) avatarEl.textContent = initials;
      // Mark as loaded
      (window as any).__sb_admin_navbar = {
        ...(window as any).__sb_admin_navbar,
        userInfoLoaded: true,
      };
    }) as EventListener);
  }
</script>
