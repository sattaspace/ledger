{
  "name": "ledgerfrontend",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "SattaBase Account Ledger — Vue + Astro 6 + Tailwind 4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
