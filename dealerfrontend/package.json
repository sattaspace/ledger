    "format": "prettier --write \"src/**/*.{ts,vue,astro,css,json}\""
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/node": "^10.1.0",
    "@astrojs/sitemap": "^3.7.2",
