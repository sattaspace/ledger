# ─── DEALERCORE v3.0 — API Configuration ─────────────────────────────────
#
# Copy this file to .env and customize for your environment.
# cp .env.example .env

# ─── API Base URL ─────────────────────────────────────────────────────────
# Set to your Django Ninja backend URL.
# Default: http://localhost:8088
VITE_API_BASE_URL=http://localhost:8088

# ─── SattaBase Integration ────────────────────────────────────────────────
# SattaBase frontend URL (port 4321) for redirects to signup, billing, etc.
# Default: http://localhost:4321
VITE_SATTABASE_URL=http://localhost:4321

# SattaBase API URL (port 8086) - used for backend, not usually needed frontend
# VITE_SATTABASE_API_URL=http://localhost:8086/api/v1

# ─── Gemini AI Key ────────────────────────────────────────────────────────
# Required for the AI Reconciliation feature in Reports.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ─── App URL ─────────────────────────────────────────────────────────────
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"