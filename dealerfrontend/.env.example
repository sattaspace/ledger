# ─── DEALERCORE — SattaBase Sister Domain Configuration ─────────────────────
#
# Copy this file to .env and customize for your environment.
# cp .env.example .env
#
# IMPORTANT: Authentication goes DIRECTLY to SattaBase backend (port 8086),
# NOT through the dealer backend. This follows the SDK pattern for sister domains.
#

# ─── SattaBase Backend API (Authentication & Billing) ───────────────────────
# The SattaBase Django Ninja backend URL for auth and billing endpoints.
# All auth requests (login, logout, refresh, /billing/auth/me) go here.
PUBLIC_API_BASE_URL_SB=http://localhost:8086/api/v1

# ─── SattaBase Frontend URL ─────────────────────────────────────────────────
# Used for redirects to signup, register, forgot-password, billing, profile.
PUBLIC_BASE_DOMAIN_URL=http://localhost:4321

# ─── This Domain URL ────────────────────────────────────────────────────────
# The URL of this dealer frontend. Used for return redirects after billing.
PUBLIC_THIS_DOMAIN_URL=http://localhost:4323

# ─── Service Domain Identifier ──────────────────────────────────────────────
# Must match the ServiceDomain record in SattaBase billing system.
# Sent as X-Service-Domain header to get domain-scoped subscription/access data.
# Production: dealer.sattaspace.com
# Development: localhost:4323
PUBLIC_SERVICE_DOMAIN=localhost:4323

# ─── Token Storage Configuration ────────────────────────────────────────────
# Prefix for localStorage/sessionStorage keys to avoid collisions.
# Results in keys like "dealercore:access_token"
PUBLIC_TOKEN_KEY_PREFIX=dealercore:

# Session cookie name (must match SattaBase backend setting)
PUBLIC_SESSION_COOKIE_NAME=sattabase_session_cookie

# ─── Dealer Backend API (Business Data Only) ────────────────────────────────
# The dealer backend URL for business data endpoints ONLY.
# NOT for authentication - auth goes to SattaBase directly.
# Endpoints: /inventory, /sales, /dsr, /supplier, /dealer, /reports
PUBLIC_DEALER_API_URL=http://localhost:8088/api

# ─── Gemini AI Key ──────────────────────────────────────────────────────────
# Required for the AI Reconciliation feature in Reports.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ─── App URL ─────────────────────────────────────────────────────────────────
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ─── Legacy Variables (Deprecated - kept for backward compatibility) ─────────
# These will be removed in a future version. Use PUBLIC_* variables instead.
# VITE_API_BASE_URL=http://localhost:8088
# VITE_SATTABASE_URL=http://localhost:4321
# VITE_SATTABASE_API_URL=http://localhost:8086/api/v1
