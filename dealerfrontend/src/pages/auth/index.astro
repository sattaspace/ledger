---
/**
 * /auth — Smart redirect page.
 *
 * If user is authenticated → redirect to /dashboard
 * If user is NOT authenticated → redirect to /auth/login
 *
 * This avoids a 404 when someone visits /auth directly.
 *
 * Since JWTs are stored client-side (sessionStorage/localStorage),
 * the redirect logic runs as an inline script in the browser.
 */
---

<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Redirecting... — Satta Ledger</title>
  </head>
  <body>
    <script is:inline>
      (function () {
        const tokenKeyPrefix = "sattabase-ledger:";
        const sessionKey = tokenKeyPrefix + "access_token";
        const localKey = tokenKeyPrefix + "access_token_long";

        const hasSession = !!sessionStorage.getItem(sessionKey);
        const hasLocal = !!localStorage.getItem(localKey);

        if (hasSession || hasLocal) {
          window.location.replace("/dashboard");
        } else {
          window.location.replace("/auth/login");
        }
      })();
    </script>
    <noscript>
      <meta http-equiv="refresh" content="0;url=/auth/login" />
    </noscript>
  </body>
</html>
