---
/**
 * AuthLayout — split-screen auth layout for Satta Ledger.
 *
 * Desktop: Left panel with Ledger branding + feature cards.
 *          Right panel for form content (slot).
 * Mobile:  Compact header with logo + form content below.
 *
 * Uses BaseLayout as wrapper.
 */

import BaseLayout from "./BaseLayout.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Sign In — Satta Ledger",
  description = "Sign in to your Satta Ledger account",
} = Astro.props;
---

<BaseLayout {title} {description}>
  <div class="flex min-h-full flex-col lg:flex-row overflow-hidden">

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- LEFT BRANDING PANEL (desktop only)                                -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="hidden lg:flex lg:w-1/2 xl:w-[55%] relative bg-navy-gradient flex-col justify-between overflow-hidden">
      <!-- Animated gradient background overlay -->
      <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
        <div class="absolute -top-32 -left-32 w-[500px] h-[500px] rounded-full bg-cyan-600/8 blur-[100px] animate-auth-blob1"></div>
        <div class="absolute bottom-0 right-0 w-[400px] h-[400px] rounded-full bg-cyan-500/6 blur-[80px] animate-auth-blob2"></div>
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[300px] h-[300px] rounded-full bg-warm-600/4 blur-[60px] animate-auth-blob3"></div>
      </div>

      <!-- Content -->
      <div class="relative z-10 flex flex-col flex-1 p-10 xl:p-14">
        <!-- Logo -->
        <div class="flex items-center gap-3 mb-16">
          <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-cyan-gradient text-white font-bold text-lg shadow-lg shadow-cyan-600/25">
            L
          </div>
          <span class="text-2xl font-bold tracking-tight text-white">Satta Ledger</span>
        </div>

        <!-- Tagline -->
        <div class="flex-1 flex flex-col justify-center max-w-md">
          <h1 class="text-3xl xl:text-4xl font-bold text-white mb-4 text-balance">
            Personal Finance<br />
            <span class="bg-gradient-to-r from-cyan-400 to-cyan-200 bg-clip-text text-transparent">Management</span>
          </h1>
          <p class="text-navy-200 text-lg leading-relaxed">
            Track every aspect of your finances — from daily expenses to long-term investments — all in one secure, intuitive platform.
          </p>
        </div>

        <!-- Feature mini-cards -->
        <div class="grid grid-cols-2 gap-3 mt-10">
          <!-- Income/Expense -->
          <div class="glass-navy rounded-xl border border-navy-500/20 p-4">
            <div class="flex items-center gap-2.5 mb-2">
              <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-credit/15">
                <svg class="h-4 w-4 text-credit" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v16m8-8H4"></path></svg>
              </div>
              <h3 class="text-sm font-semibold text-white">Income & Expense</h3>
            </div>
            <p class="text-xs text-navy-300">Track all money in and out</p>
          </div>

          <!-- Budget -->
          <div class="glass-navy rounded-xl border border-navy-500/20 p-4">
            <div class="flex items-center gap-2.5 mb-2">
              <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-cyan-600/15">
                <svg class="h-4 w-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
              </div>
              <h3 class="text-sm font-semibold text-white">Budget</h3>
            </div>
            <p class="text-xs text-navy-300">Set limits, stay on track</p>
          </div>

          <!-- Investment -->
          <div class="glass-navy rounded-xl border border-navy-500/20 p-4">
            <div class="flex items-center gap-2.5 mb-2">
              <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-credit/15">
                <svg class="h-4 w-4 text-credit" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
              </div>
              <h3 class="text-sm font-semibold text-white">Investment</h3>
            </div>
            <p class="text-xs text-navy-300">Monitor portfolio growth</p>
          </div>

          <!-- Documents -->
          <div class="glass-navy rounded-xl border border-navy-500/20 p-4">
            <div class="flex items-center gap-2.5 mb-2">
              <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-warm-600/15">
                <svg class="h-4 w-4 text-warm-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"></path></svg>
              </div>
              <h3 class="text-sm font-semibold text-white">Documents</h3>
            </div>
            <p class="text-xs text-navy-300">Secure financial vault</p>
          </div>
        </div>
      </div>

      <!-- Bottom credit -->
      <div class="relative z-10 px-10 xl:px-14 py-6 border-t border-navy-700/30">
        <p class="text-xs text-navy-400">
          Powered by <span class="text-cyan-400 font-medium">SattaBase</span>
        </p>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- RIGHT FORM PANEL                                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="flex flex-1 flex-col bg-cloud dark:bg-navy-950 overflow-y-auto">
      <!-- Mobile header -->
      <div class="lg:hidden flex items-center gap-3 px-6 py-5 border-b border-navy-200 dark:border-navy-800 bg-white dark:bg-navy-900">
        <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-cyan-600 text-white font-bold text-sm shadow-md shadow-cyan-600/20">
          L
        </div>
        <span class="text-lg font-bold tracking-tight text-navy-900 dark:text-navy-100">Satta Ledger</span>
      </div>

      <!-- Form content -->
      <div class="flex flex-1 flex-col items-center justify-center px-4 py-10 sm:px-6 lg:px-8">
        <div class="w-full max-w-md">
          <slot />
        </div>
      </div>

      <!-- Footer -->
      <div class="border-t border-navy-200 dark:border-navy-800 bg-white dark:bg-navy-900 px-6 py-4">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-slate-custom-600 dark:text-slate-custom-500">
          <a href="/" class="font-medium text-cyan-600 dark:text-cyan-400 hover:text-cyan-500 transition-colors">
            &larr; Back to home
          </a>
          <p>&copy; {new Date().getFullYear()} Satta Ledger</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Auth blob animations -->
  <style>
    @keyframes auth-blob1 {
      0%, 100% { transform: translate(0, 0) scale(1); }
      33% { transform: translate(40px, -60px) scale(1.1); }
      66% { transform: translate(-30px, 30px) scale(0.9); }
    }
    @keyframes auth-blob2 {
      0%, 100% { transform: translate(0, 0) scale(1); }
      33% { transform: translate(-50px, 40px) scale(0.95); }
      66% { transform: translate(40px, -40px) scale(1.05); }
    }
    @keyframes auth-blob3 {
      0%, 100% { transform: translate(0, 0) scale(1); }
      50% { transform: translate(30px, 50px) scale(1.08); }
    }
    .animate-auth-blob1 { animation: auth-blob1 10s ease-in-out infinite; }
    .animate-auth-blob2 { animation: auth-blob2 12s ease-in-out infinite; }
    .animate-auth-blob3 { animation: auth-blob3 14s ease-in-out infinite; }
  </style>

  <!-- Guest-only redirect: if user is already authenticated, redirect to dashboard -->
  <script>
    (function() {
      const ss = sessionStorage.getItem("sattabase-ledger:access_token");
      const ls = localStorage.getItem("sattabase-ledger:access_token");
      if (ss || ls) {
        window.location.href = "/dashboard";
      }
    })();
  </script>
</BaseLayout>
