---
/**
 * Budget detail page — /dashboard/budgets/[id]
 */

import DashboardLayout from "@/layouts/DashboardLayout.astro";
import BudgetDetail from "@/components/vue/budgets/BudgetDetail.vue";
---

<DashboardLayout title="Budget Detail — Satta Ledger">
  <BudgetDetail client:only="vue" id={Astro.params.id} />
</DashboardLayout>

<script>
  const pageTitle = document.getElementById("page-title");
  if (pageTitle) pageTitle.textContent = "Budget Detail";
</script>
