---
/**
 * Bill detail page — /dashboard/bills/[id]
 */

import DashboardLayout from "@/layouts/DashboardLayout.astro";
import BillDetail from "@/components/vue/bills/BillDetail.vue";
---

<DashboardLayout title="Bill Detail — Satta Ledger">
  <BillDetail client:only="vue" id={Astro.params.id} />
</DashboardLayout>

<script>
  const pageTitle = document.getElementById("page-title");
  if (pageTitle) pageTitle.textContent = "Bill Detail";
</script>
