---
/**
 * Account detail page — /dashboard/accounts/[id]
 */

import DashboardLayout from "@/layouts/DashboardLayout.astro";
import AccountDetail from "@/components/vue/accounts/AccountDetail.vue";
---

<DashboardLayout title="Account Detail — Satta Ledger">
  <AccountDetail client:only="vue" id={Astro.params.id} />
</DashboardLayout>

<script>
  const pageTitle = document.getElementById("page-title");
  if (pageTitle) pageTitle.textContent = "Account Detail";
</script>
