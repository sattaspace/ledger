---
/**
 * Financial Calendar page — /dashboard/calendar
 * Calendar view showing bills due, insurance renewals, budget periods,
 * debt payment schedules, and savings goal deadlines.
 */

import DashboardLayout from "@/layouts/DashboardLayout.astro";
import CalendarPage from "@/components/vue/calendar/CalendarPage.vue";
---

<DashboardLayout title="Financial Calendar — Satta Ledger">
  <CalendarPage client:only="vue" />
</DashboardLayout>

<script>
  const pageTitle = document.getElementById("page-title");
  if (pageTitle) pageTitle.textContent = "Financial Calendar";
</script>
