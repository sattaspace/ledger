---
/**
 * DashboardLayout — authenticated layout with sidebar for Satta Ledger.
 */

import BaseLayout from "./BaseLayout.astro";
---

<BaseLayout title="Dashboard — Satta Ledger" description="Your Ledger dashboard">
  <div class="flex h-dvh overflow-hidden">
    <!-- Desktop Sidebar -->
    <aside
      class="hidden lg:flex lg:w-64 lg:flex-col lg:fixed lg:inset-y-0 z-30 bg-white/80 dark:bg-navy-900/80 border-r border-navy-200 dark:border-navy-700 backdrop-blur-sm"
    >
      <div id="dashboard-sidebar-content" class="flex h-full flex-col">
        <!-- Logo -->
        <div class="flex h-16 items-center gap-3 px-6 border-b border-navy-200 dark:border-navy-700">
          <div
            class="flex h-9 w-9 items-center justify-center rounded-lg bg-cyan-600 text-white font-bold text-sm shadow-md shadow-cyan-600/20"
          >
            L
          </div>
          <span class="text-lg font-bold tracking-tight text-navy-900 dark:text-navy-100">Satta Ledger</span>
        </div>

        <!-- Navigation -->
        <nav
          class="flex-1 space-y-1 overflow-y-auto px-3 py-4"
          aria-label="Main navigation"
        >
          <a
            href="/dashboard"
            class="nav-item group relative flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-slate-custom-700 dark:text-slate-custom-400 hover:bg-cyan-50 dark:hover:bg-navy-800 hover:text-navy-900 dark:hover:text-navy-100 transition-all duration-200"
          >
            <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v5a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM14 5a1 1 0 011-1h4a1 1 0 011 1v2a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1v-4zM14 12a1 1 0 011-1h4a1 1 0 011 1v7a1 1 0 01-1 1h-4a1 1 0 01-1-1v-7z"></path>
            </svg>
            <span class="truncate">Dashboard</span>
          </a>

          <!-- Core Section -->
          <div class="pt-3 pb-1 px-3">
            <p class="text-[10px] font-semibold uppercase tracking-wider text-slate-custom-500 dark:text-slate-custom-600">Core</p>
          </div>

          <a
            href="/dashboard/transactions"
            class="nav-item group relative flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-slate-custom-700 dark:text-slate-custom-400 hover:bg-cyan-50 dark:hover:bg-navy-800 hover:text-navy-900 dark:hover:text-navy-100 transition-all duration-200"
          >
            <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"></path>
            </svg>
            <span class="truncate">Transactions</span>
          </a>

          <a
            href="/dashboard/accounts"
            class="nav-item group relative flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-slate-custom-700 dark:text-slate-custom-400 hover:bg-cyan-50 dark:hover:bg-navy-800 hover:text-navy-900 dark:hover:text-navy-100 transition-all duration-200"
          >
            <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
            </svg>
            <span class="truncate">Accounts</span>
          </a>

          <a
            href="/dashboard/institutions"
            class="nav-item group relative flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-slate-custom-700 dark:text-slate-custom-400 hover:bg-cyan-50 dark:hover:bg-navy-800 hover:text-navy-900 dark:hover:text-navy-100 transition-all duration-200"
          >
            <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
            </svg>
            <span class="truncate">Institutions</span>
          </a>

          <a
            href="/dashboard/categories"
            class="nav-item group relative flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-slate-custom-700 dark:text-slate-custom-400 hover:bg-cyan-50 dark:hover:bg-navy-800 hover:text-navy-900 dark:hover:text-navy-100 transition-all duration-200"
          >
            <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path>
            </svg>
            <span class="truncate">Categories</span>
          </a>

          <a
            href="/dashboard/tags"
            class="nav-item group relative flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-slate-custom-700 dark:text-slate-custom-400 hover:bg-cyan-50 dark:hover:bg-navy-800 hover:text-navy-900 dark:hover:text-navy-100 transition-all duration-200"
          >
            <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z"></path>
            </svg>
            <span class="truncate">Tags</span>
          </a>

          <!-- Planning Section -->
          <div class="pt-5 pb-1 px-3">
            <p class="text-[10px] font-semibold uppercase tracking-wider text-slate-custom-500 dark:text-slate-custom-600">Planning</p>
          </div>

          <a
            href="/dashboard/bills"
            class="nav-item group relative flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-slate-custom-700 dark:text-slate-custom-400 hover:bg-cyan-50 dark:hover:bg-navy-800 hover:text-navy-900 dark:hover:text-navy-100 transition-all duration-200"
          >
            <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
            </svg>
            <span class="truncate">Bills</span>
          </a>

          <a
            href="/dashboard/budgets"
            class="nav-item group relative flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-slate-custom-700 dark:text-slate-custom-400 hover:bg-cyan-50 dark:hover:bg-navy-800 hover:text-navy-900 dark:hover:text-navy-100 transition-all duration-200"
          >
            <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
            <span class="truncate">Budgets</span>
          </a>

          <!-- Cards & Debt Section -->
          <div class="pt-5 pb-1 px-3">
            <p class="text-[10px] font-semibold uppercase tracking-wider text-slate-custom-500 dark:text-slate-custom-600">Cards & Debt</p>
          </div>

          <a
            href="/dashboard/cards"
            class="nav-item group relative flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-slate-custom-700 dark:text-slate-custom-400 hover:bg-cyan-50 dark:hover:bg-navy-800 hover:text-navy-900 dark:hover:text-navy-100 transition-all duration-200"
          >
            <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
            </svg>
            <span class="truncate">Cards</span>
          </a>

          <a
            href="/dashboard/debts"
            class="nav-item group relative flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-slate-custom-700 dark:text-slate-custom-400 hover:bg-cyan-50 dark:hover:bg-navy-800 hover:text-navy-900 dark:hover:text-navy-100 transition-all duration-200"
          >
            <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
            <span class="truncate">Debts</span>
          </a>
        </nav>

        <!-- Bottom section -->
        <div class="border-t border-navy-200 dark:border-navy-700 bg-white dark:bg-navy-900">
          <!-- User info -->
          <div class="px-4 py-3">
            <div
              id="sidebar-user-info"
              class="flex items-center gap-3 rounded-lg p-1 -mx-1 transition-colors hover:bg-cyan-50 dark:hover:bg-navy-800 cursor-pointer"
            >
              <div
                class="flex h-9 w-9 items-center justify-center rounded-full bg-gradient-to-br from-cyan-500 to-cyan-700 text-white text-xs font-bold shrink-0"
              >
                <span id="sidebar-user-avatar">?</span>
              </div>
              <div class="flex-1 min-w-0">
                <p
                  class="truncate text-sm font-medium leading-tight text-navy-900 dark:text-navy-100"
                  id="sidebar-user-name"
                >
                  Loading...
                </p>
                <p
                  class="truncate text-[11px] text-slate-custom-600 dark:text-slate-custom-500 mt-0.5"
                  id="sidebar-user-email"
                >
                  ...
                </p>
              </div>
            </div>
          </div>

          <!-- Sign out -->
          <button
            type="button"
            class="flex w-full items-center gap-3 px-6 py-2.5 text-sm font-medium text-slate-custom-600 dark:text-slate-custom-500 transition-all duration-200 hover:bg-red-50 dark:hover:bg-red-950/30 hover:text-red-600 dark:hover:text-red-400 border-t border-navy-200 dark:border-navy-700"
            id="sidebar-sign-out"
            aria-label="Sign out"
          >
            <svg
              class="h-4 w-4 shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
              ></path>
            </svg>
            <span>Sign out</span>
          </button>
        </div>
      </div>
    </aside>

    <!-- Mobile top bar -->
    <div class="flex flex-1 flex-col min-w-0 lg:pl-64">
      <!-- Top bar -->
      <header
        class="shrink-0 flex h-14 items-center gap-4 border-b border-navy-200 dark:border-navy-700 bg-white/80 dark:bg-navy-900/80 backdrop-blur-sm px-4 lg:px-6"
      >
        <!-- Mobile menu toggle -->
        <button
          type="button"
          class="lg:hidden inline-flex items-center justify-center rounded-lg p-2 text-slate-custom-700 dark:text-slate-custom-400 hover:bg-cyan-50 dark:hover:bg-navy-800 transition-colors"
          id="mobile-menu-toggle"
          aria-label="Open menu"
        >
          <svg
            class="h-5 w-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>

        <!-- Page title area -->
        <div class="flex-1">
          <h1 class="text-sm font-medium text-navy-900 dark:text-navy-100" id="page-title">
            Dashboard
          </h1>
        </div>

        <!-- Right side actions -->
        <div class="flex items-center gap-2">
          <!-- Theme toggle -->
          <button
            type="button"
            class="inline-flex items-center justify-center rounded-lg p-2 text-slate-custom-700 dark:text-slate-custom-400 hover:bg-cyan-50 dark:hover:bg-navy-800 transition-colors"
            id="theme-toggle"
            aria-label="Toggle dark mode"
          >
            <svg
              class="h-4 w-4 dark:hidden"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
              ></path>
            </svg>
            <svg
              class="h-4 w-4 hidden dark:block"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
              ></path>
            </svg>
          </button>
        </div>
      </header>

      <!-- Content area -->
      <main class="flex-1 overflow-y-auto">
        <div class="p-4 md:p-6 lg:p-8">
          <div class="mx-auto max-w-7xl">
            <slot />
          </div>
        </div>
      </main>
    </div>
  </div>
</BaseLayout>

<script>
  // ── Sign out handler ──
  const signOutBtn = document.getElementById("sidebar-sign-out");
  signOutBtn?.addEventListener("click", async () => {
    try {
      const { logout } = await import("@/lib/auth");
      await logout();
    } catch {
      const { clearTokens } = await import("@/lib/api");
      clearTokens();
      window.location.href = "/auth/login";
    }
  });

  // ── Theme toggle ──
  const themeToggle = document.getElementById("theme-toggle");
  themeToggle?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
  });

  // ── Load user info into sidebar ──
  async function loadSidebarUserInfo() {
    try {
      const { apiClient } = await import("@/lib/api");
      const data = await apiClient.get<{ user: any; subscription: any }>(
        "/billing/auth/me",
      );

      const userName = document.getElementById("sidebar-user-name");
      const userEmail = document.getElementById("sidebar-user-email");
      const userAvatar = document.getElementById("sidebar-user-avatar");

      if (data?.user) {
        const name =
          data.user.full_name ||
          data.user.display_name ||
          data.user.email?.split("@")[0] ||
          "User";
        if (userName) userName.textContent = name;
        if (userEmail) userEmail.textContent = data.user.email || "";
        if (userAvatar) userAvatar.textContent = name.charAt(0).toUpperCase();
      }
    } catch {
      // Not authenticated — sidebar shows defaults
    }
  }

  loadSidebarUserInfo();
  document.addEventListener("astro:page-load", loadSidebarUserInfo);
</script>
