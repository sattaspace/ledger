---
/**
 * DashboardLayout — "frozen shell" pattern for Satta Ledger.
 *
 * Key architecture:
 *   - Frozen sidebar with `transition:persist="app-sidebar"` → survives navigation
 *   - Mobile sidebar overlay with swipe-to-dismiss, backdrop blur, ResizeObserver
 *   - Frozen topbar with `transition:persist="app-navbar"` → survives navigation
 *   - Island content area with rounded corners, subtle background, NOT persisted → swaps on navigation
 *   - View transition suppression CSS (kill root animation, suppress on frozen elements)
 *   - Island fade-in animation
 *   - Sign out handler, theme toggle handler, user info loading
 *
 * Uses BaseLayout as wrapper.
 * Sidebar nav links are defined in Sidebar.astro (data-driven navSections).
 * Topbar is defined in Navbar.astro.
 */

import BaseLayout from "./BaseLayout.astro";
import Sidebar from "@/components/astro/Sidebar.astro";
import Navbar from "@/components/astro/Navbar.astro";
import ToastContainer from "@/components/vue/ToastContainer.vue";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Dashboard — Satta Ledger",
  description = "Your Ledger dashboard",
} = Astro.props;
---

<BaseLayout {title} {description}>
  <!-- View transition suppression styles -->
  <style is:inline>
    /* Kill root animation for view transitions */
    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation: none !important;
    }

    /* Suppress transition on frozen (persisted) elements */
    ::view-transition-old(app-sidebar),
    ::view-transition-new(app-sidebar),
    ::view-transition-old(app-navbar),
    ::view-transition-new(app-navbar) {
      animation: none !important;
    }

    /* Island fade-in keyframe */
    @keyframes island-fade-in {
      from { opacity: 0; transform: translateY(4px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .island-content {
      animation: island-fade-in 0.25s ease-out;
    }

    /* Mobile sidebar overlay */
    .sidebar-overlay-backdrop {
      transition: opacity 0.25s ease;
    }

    .sidebar-overlay-panel {
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Mobile sidebar scrollbar */
    .mobile-sidebar-scroll::-webkit-scrollbar {
      width: 4px;
    }
    .mobile-sidebar-scroll::-webkit-scrollbar-track {
      background: transparent;
    }
    .mobile-sidebar-scroll::-webkit-scrollbar-thumb {
      background: var(--color-navy-200);
      border-radius: 9999px;
    }
    .dark .mobile-sidebar-scroll::-webkit-scrollbar-thumb {
      background: var(--color-navy-700);
    }
  </style>

  <!-- Skip to content link (accessibility) -->
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[200] focus:rounded-lg focus:bg-cyan-600 focus:px-4 focus:py-2 focus:text-white focus:text-sm focus:font-medium focus:shadow-lg"
  >
    Skip to content
  </a>

  <!-- Shell: full viewport height, overflow hidden -->
  <div class="h-dvh overflow-hidden flex" id="dashboard-shell">

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- FROZEN SIDEBAR (desktop)                                          -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div
      class="hidden lg:flex lg:w-64 lg:flex-col lg:shrink-0 z-30"
      transition:persist="app-sidebar"
      transition:animate="none"
    >
      <Sidebar />
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- MOBILE SIDEBAR OVERLAY                                            -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div id="mobile-sidebar-overlay" class="fixed inset-0 z-40 lg:hidden" style="display: none;">
      <!-- Backdrop -->
      <div
        id="mobile-sidebar-backdrop"
        class="sidebar-overlay-backdrop absolute inset-0 bg-navy-900/50 backdrop-blur-sm opacity-0"
      ></div>

      <!-- Panel -->
      <div
        id="mobile-sidebar-panel"
        class="sidebar-overlay-panel absolute inset-y-0 left-0 w-72 max-w-[80vw] -translate-x-full"
      >
        <div class="flex h-full flex-col bg-white dark:bg-navy-900 mobile-sidebar-scroll overflow-y-auto">
          <Sidebar />
        </div>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- MAIN AREA (topbar + island)                                       -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="flex flex-1 flex-col min-w-0">

      <!-- FROZEN TOPBAR -->
      <div transition:persist="app-navbar" transition:animate="none">
        <Navbar />
      </div>

      <!-- ISLAND CONTENT AREA (not persisted — swaps on navigation) -->
      <div id="main-content" class="flex-1 overflow-y-auto bg-cloud-bright dark:bg-navy-950/50" tabindex="-1">
        <div class="p-3 sm:p-4 md:p-6 lg:p-8">
          <div class="island-content mx-auto max-w-7xl rounded-[25px] border border-navy-200/50 dark:border-navy-700/30 bg-white dark:bg-navy-900/80 shadow-sm p-4 sm:p-6 md:p-8">
            <slot />
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Global Toast Notification Container -->
  <ToastContainer client:load />
</BaseLayout>

<script>
  // ── Mobile sidebar toggle ──
  const overlay = document.getElementById('mobile-sidebar-overlay');
  const backdrop = document.getElementById('mobile-sidebar-backdrop');
  const panel = document.getElementById('mobile-sidebar-panel');

  let mobileSidebarOpen = false;

  function openMobileSidebar() {
    if (!overlay || !backdrop || !panel) return;
    mobileSidebarOpen = true;
    overlay.style.display = 'block';
    // Force reflow
    overlay.offsetHeight;
    backdrop.classList.remove('opacity-0');
    backdrop.classList.add('opacity-100');
    panel.classList.remove('-translate-x-full');
    panel.classList.add('translate-x-0');
    document.body.style.overflow = 'hidden';
  }

  function closeMobileSidebar() {
    if (!overlay || !backdrop || !panel) return;
    mobileSidebarOpen = false;
    backdrop.classList.remove('opacity-100');
    backdrop.classList.add('opacity-0');
    panel.classList.remove('translate-x-0');
    panel.classList.add('-translate-x-full');
    document.body.style.overflow = '';
    setTimeout(() => {
      if (!mobileSidebarOpen) {
        overlay.style.display = 'none';
      }
    }, 300);
  }

  // Listen for toggle event from Navbar
  document.addEventListener('toggle-mobile-sidebar', ((e: CustomEvent) => {
    const shouldOpen = e.detail?.open ?? true;
    if (shouldOpen && !mobileSidebarOpen) {
      openMobileSidebar();
    } else if (!shouldOpen && mobileSidebarOpen) {
      closeMobileSidebar();
    } else if (mobileSidebarOpen) {
      closeMobileSidebar();
    } else {
      openMobileSidebar();
    }
  }) as EventListener);

  // Backdrop click closes sidebar
  backdrop?.addEventListener('click', closeMobileSidebar);

  // ── Swipe-to-dismiss (touch gestures) ──
  let touchStartX = 0;
  let touchCurrentX = 0;
  let isSwiping = false;

  panel?.addEventListener('touchstart', (e: TouchEvent) => {
    if (!e.touches[0]) return;
    touchStartX = e.touches[0].clientX;
    isSwiping = true;
  }, { passive: true });

  panel?.addEventListener('touchmove', (e: TouchEvent) => {
    if (!isSwiping || !e.touches[0]) return;
    touchCurrentX = e.touches[0].clientX;
    const diff = touchCurrentX - touchStartX;
    if (diff < 0 && panel) {
      // Swiping left — dismiss
      panel.style.transform = `translateX(${diff}px)`;
    }
  }, { passive: true });

  panel?.addEventListener('touchend', () => {
    if (!isSwiping) return;
    isSwiping = false;
    const diff = touchCurrentX - touchStartX;
    if (diff < -60) {
      closeMobileSidebar();
    } else if (panel) {
      // Snap back
      panel.style.transform = '';
      if (mobileSidebarOpen) {
        panel.classList.add('translate-x-0');
        panel.classList.remove('-translate-x-full');
      }
    }
    touchStartX = 0;
    touchCurrentX = 0;
  });

  // ── ResizeObserver: close mobile sidebar on lg breakpoint ──
  if (typeof ResizeObserver !== 'undefined' && overlay) {
    const ro = new ResizeObserver(() => {
      if (window.innerWidth >= 1024 && mobileSidebarOpen) {
        closeMobileSidebar();
      }
    });
    ro.observe(document.documentElement);
  }

  // ── Sign out handler (sidebar) ──
  const sidebarSignOut = document.getElementById('sidebar-sign-out');
  sidebarSignOut?.addEventListener('click', async () => {
    try {
      const { logout } = await import('@/lib/auth');
      await logout();
    } catch {
      const { clearTokens } = await import('@/lib/api');
      clearTokens();
      window.location.href = '/auth/login';
    }
  });

  // ── Manage plan button ──
  const managePlanBtn = document.getElementById('sidebar-manage-plan');
  managePlanBtn?.addEventListener('click', async () => {
    try {
      const { redirectToBaseWithAuthCode } = await import('@/lib/auth');
      await redirectToBaseWithAuthCode('/dashboard/billing');
    } catch {
      const { redirectToBase } = await import('@/lib/auth');
      redirectToBase('/dashboard/billing');
    }
  });

  // ── Load user info into sidebar & navbar ──
  async function loadUserInfo() {
    try {
      const { apiClient } = await import('@/lib/api');
      const data = await apiClient.get<{ user: any; subscription: any; access?: Record<string, unknown>; exchange_rates?: unknown; currencies?: unknown }>('/billing/auth/me');

      // ── Cache access data for sidebar feature gating ──
      if (data?.access && typeof data.access === 'object') {
        try {
          sessionStorage.setItem('sattabase:auth_access', JSON.stringify(data.access));
        } catch { /* sessionStorage full or unavailable */ }

        // Re-apply feature gating now that access data is available
        const gatedItems = document.querySelectorAll<HTMLElement>('.sidebar-nav-item[data-feature]');
        gatedItems.forEach((item) => {
          const feature = item.getAttribute('data-feature');
          if (!feature) return;
          const value = (data.access as Record<string, unknown>)[feature];
          const hasAccess = value === true || (typeof value === 'number' && value > 0)
            || (typeof value === 'string' && value !== '' && value !== 'false' && value !== '0');
          item.style.display = hasAccess ? '' : 'none';
        });

        // Hide section headers when all items are hidden
        const sections = document.querySelectorAll<HTMLElement>('[data-sidebar-section]');
        sections.forEach((section) => {
          const items = section.querySelectorAll<HTMLElement>('.sidebar-nav-item');
          const visibleItems = Array.from(items).filter(
            (item) => item.style.display !== 'none'
          );
          if (items.length > 0 && visibleItems.length === 0) {
            section.style.display = 'none';
          } else {
            section.style.display = '';
          }
        });
      }

      // ── Cache currency metadata & exchange rates for Vue components ──
      if (data?.currencies || data?.exchange_rates) {
        try {
          const { cacheCurrenciesMeta, cacheExchangeRates } = await import('@/lib/currency');
          if (data.currencies) cacheCurrenciesMeta(data.currencies as Record<string, unknown>);
          if (data.exchange_rates && data.user) {
            cacheExchangeRates(data as any);
          }
        } catch { /* currency caching failed — non-critical */ }
      }

      if (data?.user) {
        const name =
          data.user.full_name ||
          data.user.display_name ||
          data.user.email?.split('@')[0] ||
          'User';
        const initial = name.charAt(0).toUpperCase();

        // Sidebar user info
        const sidebarName = document.getElementById('sidebar-user-name');
        const sidebarEmail = document.getElementById('sidebar-user-email');
        const sidebarAvatar = document.getElementById('sidebar-user-avatar');
        if (sidebarName) sidebarName.textContent = name;
        if (sidebarEmail) sidebarEmail.textContent = data.user.email || '';
        if (sidebarAvatar) sidebarAvatar.textContent = initial;

        // Navbar user info
        const navbarAvatar = document.getElementById('navbar-user-avatar');
        const navbarName = document.getElementById('navbar-user-name');
        const dropdownName = document.getElementById('navbar-dropdown-name');
        const dropdownEmail = document.getElementById('navbar-dropdown-email');
        if (navbarAvatar) navbarAvatar.textContent = initial;
        if (navbarName) navbarName.textContent = name;
        if (dropdownName) dropdownName.textContent = name;
        if (dropdownEmail) dropdownEmail.textContent = data.user.email || '';
      }

      if (data?.subscription) {
        const planName = document.getElementById('sidebar-plan-name');
        const planDot = document.getElementById('sidebar-plan-dot');
        if (planName) planName.textContent = data.subscription.plan_name || 'Free Plan';
        if (planDot && data.subscription.status === 'active') {
          planDot.className = 'h-2 w-2 rounded-full bg-cyan-500';
        } else if (planDot) {
          planDot.className = 'h-2 w-2 rounded-full bg-warm-500 animate-pulse';
        }
      } else {
        const planDot = document.getElementById('sidebar-plan-dot');
        if (planDot) planDot.className = 'h-2 w-2 rounded-full bg-slate-custom-400';
      }
    } catch {
      // Not authenticated — show defaults
    }
  }

  loadUserInfo();
  document.addEventListener('astro:page-load', loadUserInfo);

  // ── Global keyboard shortcuts ──
  // Ctrl+K → focus search input on current page
  // Ctrl+N → navigate to new transaction
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    // Skip when typing in input fields
    const target = e.target as HTMLElement | null;
    if (!target) return;
    const tag = target.tagName;
    if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || target.isContentEditable) return;

    // Ctrl+K / Cmd+K → Focus search
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
      e.preventDefault();
      // Find the first visible search input on the page
      const searchInput = document.querySelector<HTMLInputElement>('.search-input input, input[type="search"], [data-search-input]');
      if (searchInput) {
        searchInput.focus();
      }
      return;
    }

    // Ctrl+N / Cmd+N → Quick-add transaction
    if ((e.ctrlKey || e.metaKey) && e.key === 'n') {
      e.preventDefault();
      // Navigate to transactions page if not already there
      // Or click the "Add Transaction" button if on the page
      const addBtn = document.querySelector<HTMLButtonElement>('[data-quick-add-transaction]');
      if (addBtn) {
        addBtn.click();
      } else {
        window.location.href = '/dashboard/transactions';
      }
      return;
    }
  });
</script>
