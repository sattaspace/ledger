---
/**
 * Navbar — top navigation bar for Satta Ledger dashboard.
 *
 * Left: Mobile menu toggle, mobile logo, desktop breadcrumb
 * Right: Dark mode toggle, notification bell, user dropdown
 *
 * Mobile sidebar toggle dispatches 'toggle-mobile-sidebar' custom event.
 * User dropdown with click-outside-to-close behavior.
 */
---

<header
  id="ledger-navbar"
  class="shrink-0 flex h-14 items-center gap-4 border-b border-navy-200 dark:border-navy-700 bg-white/80 dark:bg-navy-900/80 backdrop-blur-sm px-4 lg:px-6"
  role="banner"
>
  <!-- Left section -->
  <div class="flex items-center gap-3 min-w-0">
    <!-- Mobile menu toggle -->
    <button
      type="button"
      class="lg:hidden inline-flex items-center justify-center rounded-lg p-2 text-slate-custom-700 dark:text-slate-custom-400 hover:bg-cyan-50 dark:hover:bg-navy-800 transition-colors focus-ring"
      id="navbar-mobile-menu-toggle"
      aria-label="Open menu"
    >
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>

    <!-- Mobile logo -->
    <div class="lg:hidden flex items-center gap-2">
      <div class="flex h-7 w-7 items-center justify-center rounded-md bg-cyan-600 text-white font-bold text-xs shadow-sm shadow-cyan-600/20">
        L
      </div>
      <span class="text-sm font-bold tracking-tight text-navy-900 dark:text-navy-100">Satta Ledger</span>
    </div>

    <!-- Desktop breadcrumb / page title -->
    <nav class="hidden lg:flex items-center gap-2 text-sm" aria-label="Breadcrumb">
      <span class="text-slate-custom-600 dark:text-slate-custom-500">Satta Ledger</span>
      <svg class="h-3.5 w-3.5 text-slate-custom-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
      </svg>
      <span class="font-medium text-navy-900 dark:text-navy-100" id="navbar-page-title">Dashboard</span>
    </nav>
  </div>

  <!-- Spacer -->
  <div class="flex-1"></div>

  <!-- Right section -->
  <div class="flex items-center gap-1.5">
    <!-- Dark mode toggle -->
    <button
      type="button"
      class="inline-flex items-center justify-center rounded-lg p-2 text-slate-custom-700 dark:text-slate-custom-400 hover:bg-cyan-50 dark:hover:bg-navy-800 transition-colors focus-ring"
      id="navbar-theme-toggle"
      aria-label="Toggle dark mode"
    >
      <!-- Sun icon (shown in dark mode) -->
      <svg class="h-4 w-4 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
      </svg>
      <!-- Moon icon (shown in light mode) -->
      <svg class="h-4 w-4 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
      </svg>
    </button>

    <!-- Notification bell (placeholder) -->
    <button
      type="button"
      class="relative inline-flex items-center justify-center rounded-lg p-2 text-slate-custom-700 dark:text-slate-custom-400 hover:bg-cyan-50 dark:hover:bg-navy-800 transition-colors focus-ring"
      aria-label="Notifications"
    >
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
      </svg>
      <!-- Notification dot -->
      <span class="absolute top-1.5 right-1.5 h-2 w-2 rounded-full bg-warm-500 ring-2 ring-white dark:ring-navy-900"></span>
    </button>

    <!-- Divider -->
    <div class="h-6 w-px bg-navy-200 dark:bg-navy-700 mx-1.5"></div>

    <!-- User dropdown -->
    <div class="relative" id="navbar-user-dropdown-container">
      <button
        type="button"
        class="flex items-center gap-2 rounded-lg px-2 py-1.5 text-sm font-medium text-navy-900 dark:text-navy-100 hover:bg-cyan-50 dark:hover:bg-navy-800 transition-colors focus-ring"
        id="navbar-user-dropdown-toggle"
        aria-expanded="false"
        aria-haspopup="true"
      >
        <!-- Avatar -->
        <div class="flex h-7 w-7 items-center justify-center rounded-full bg-gradient-to-br from-cyan-500 to-cyan-700 text-white text-xs font-bold shrink-0">
          <span id="navbar-user-avatar">?</span>
        </div>
        <span class="hidden sm:inline truncate max-w-[120px]" id="navbar-user-name">User</span>
        <svg class="h-3.5 w-3.5 text-slate-custom-500 transition-transform duration-150" id="navbar-dropdown-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
        </svg>
      </button>

      <!-- Dropdown menu -->
      <div
        id="navbar-user-dropdown"
        class="absolute right-0 top-full mt-1.5 w-56 rounded-xl border border-navy-200 dark:border-navy-700 bg-white dark:bg-navy-800 shadow-lg shadow-navy-900/10 dark:shadow-black/20 py-1.5 z-50 animate-scale-in"
        style="display: none;"
        role="menu"
      >
        <!-- User info header -->
        <div class="px-4 py-2.5 border-b border-navy-200 dark:border-navy-700">
          <p class="text-sm font-medium text-navy-900 dark:text-navy-100 truncate" id="navbar-dropdown-name">User</p>
          <p class="text-xs text-slate-custom-600 dark:text-slate-custom-500 truncate mt-0.5" id="navbar-dropdown-email">user@example.com</p>
        </div>

        <!-- Menu items -->
        <div class="py-1">
          <button
            type="button"
            class="flex w-full items-center gap-3 px-4 py-2 text-sm text-slate-custom-700 dark:text-slate-custom-400 hover:bg-cyan-50 dark:hover:bg-navy-700 hover:text-navy-900 dark:hover:text-navy-100 transition-colors"
            id="navbar-account-billing"
            role="menuitem"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
            Account & Billing
          </button>
        </div>

        <div class="border-t border-navy-200 dark:border-navy-700 py-1">
          <button
            type="button"
            class="flex w-full items-center gap-3 px-4 py-2 text-sm text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/20 transition-colors"
            id="navbar-sign-out"
            role="menuitem"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
            </svg>
            Sign out
          </button>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  // ── Mobile menu toggle ──
  const mobileMenuToggle = document.getElementById('navbar-mobile-menu-toggle');
  mobileMenuToggle?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('toggle-mobile-sidebar', { detail: { open: true } }));
  });

  // ── Theme toggle ──
  const themeToggle = document.getElementById('navbar-theme-toggle');
  themeToggle?.addEventListener('click', () => {
    const html = document.documentElement;
    const isDark = html.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    // Update theme-color meta tags
    const lightMeta = document.querySelector('meta[name="theme-color"][media="(prefers-color-scheme: light)"]');
    const darkMeta = document.querySelector('meta[name="theme-color"][media="(prefers-color-scheme: dark)"]');
    if (lightMeta) lightMeta.setAttribute('content', isDark ? '#050E1F' : '#00B4E6');
    if (darkMeta) darkMeta.setAttribute('content', isDark ? '#050E1F' : '#00B4E6');
  });

  // ── Account & Billing redirect ──
  const accountBillingBtn = document.getElementById('navbar-account-billing');
  accountBillingBtn?.addEventListener('click', async () => {
    try {
      const { redirectToBaseWithAuthCode } = await import('@/lib/auth');
      await redirectToBaseWithAuthCode('/dashboard/profile');
    } catch {
      const { redirectToBase } = await import('@/lib/auth');
      redirectToBase('/dashboard/profile');
    }
  });

  // ── User dropdown ──
  const dropdownToggle = document.getElementById('navbar-user-dropdown-toggle');
  const dropdown = document.getElementById('navbar-user-dropdown');
  const dropdownChevron = document.getElementById('navbar-dropdown-chevron');

  function openDropdown() {
    if (dropdown) dropdown.style.display = 'block';
    if (dropdownChevron) dropdownChevron.classList.add('rotate-180');
    dropdownToggle?.setAttribute('aria-expanded', 'true');
  }

  function closeDropdown() {
    if (dropdown) dropdown.style.display = 'none';
    if (dropdownChevron) dropdownChevron.classList.remove('rotate-180');
    dropdownToggle?.setAttribute('aria-expanded', 'false');
  }

  dropdownToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = dropdown?.style.display !== 'none';
    if (isOpen) {
      closeDropdown();
    } else {
      openDropdown();
    }
  });

  // Click outside to close
  document.addEventListener('click', (e) => {
    const container = document.getElementById('navbar-user-dropdown-container');
    if (container && !container.contains(e.target as Node)) {
      closeDropdown();
    }
  });

  // Escape to close
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeDropdown();
    }
  });

  // ── Sign out from dropdown ──
  const navbarSignOut = document.getElementById('navbar-sign-out');
  navbarSignOut?.addEventListener('click', async () => {
    try {
      const { logout } = await import('@/lib/auth');
      await logout();
    } catch {
      const { clearTokens } = await import('@/lib/api');
      clearTokens();
      window.location.href = '/auth/login';
    }
  });

  // ── Update page title from URL ──
  function updatePageTitle() {
    const pageTitle = document.getElementById('navbar-page-title');
    if (!pageTitle) return;
    const path = window.location.pathname;
    const segments = path.split('/').filter(Boolean);
    if (segments.length <= 1) {
      pageTitle.textContent = 'Dashboard';
    } else {
      const lastSegment = segments[segments.length - 1] ?? 'dashboard';
      pageTitle.textContent = lastSegment
        .split('-')
        .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
        .join(' ');
    }
  }

  updatePageTitle();
  document.addEventListener('astro:page-load', updatePageTitle);
</script>
