{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Group": {
      "title": "Group",
      "description": "A group of users tracking expenses together (e.g., household, trip)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "type": { "type": "string", "enum": ["personal", "household", "trip", "other"] },
        "memberIds": { "type": "array", "items": { "type": "string" } },
        "maxBudget": { "type": "number" },
        "budgetType": { "type": "string", "enum": ["weekly", "monthly", "total"] }
      },
      "required": ["name", "createdBy", "type", "memberIds"]
    },
    "Expense": {
      "title": "Expense",
      "description": "An expense record within a group",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "amount": { "type": "number" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "paidBy": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "splitType": { "type": "string", "enum": ["equal", "percentage", "exact"] }
      },
      "required": ["amount", "description", "paidBy", "date", "category"]
    },
    "GroupMember": {
      "title": "Group Member",
      "description": "A user's membership in a group",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "member"] },
        "joinedAt": { "type": "string", "format": "date-time" },
        "displayName": { "type": "string" },
        "email": { "type": "string" }
      },
      "required": ["uid", "role"]
    },
    "FinancialAccount": {
      "title": "Financial Account",
      "description": "A digital representation of checking, savings accounts or physical cards",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "groupId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["checking", "savings", "credit_card", "debit_card"] },
        "bankName": { "type": "string" },
        "cardNumber": { "type": "string" },
        "balance": { "type": "number" },
        "creditLimit": { "type": "number" },
        "color": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "groupId", "name", "type", "balance"]
    },
    "AccountTransaction": {
      "title": "Account Transaction",
      "description": "Ledger double-entry posting under a visual financial account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "groupId": { "type": "string" },
        "accountId": { "type": "string" },
        "amount": { "type": "number" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "note": { "type": "string" },
        "transferToAccountId": { "type": "string" },
        "type": { "type": "string", "enum": ["expense", "deposit", "transfer", "payment"] }
      },
      "required": ["id", "groupId", "accountId", "amount", "description", "category", "date"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/groups/{groupId}": {
      "schema": "Group",
      "description": "Group metadata"
    },
    "/groups/{groupId}/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Expenses belonging to a group"
    },
    "/groups/{groupId}/members/{userId}": {
      "schema": "GroupMember",
      "description": "Members of a group"
    },
    "/groups/{groupId}/financial_accounts/{accountId}": {
      "schema": "FinancialAccount",
      "description": "Financial accounts belonging to a group"
    },
    "/groups/{groupId}/account_transactions/{transactionId}": {
      "schema": "AccountTransaction",
      "description": "Ledger transactions belonging to a group"
    }
  }
}
