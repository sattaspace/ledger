# ─── DEALERCORE v3.0 — Backend Environment Configuration ─────────────────
#
# Copy this file to .env and customize:
#   cp .env.example .env
#
# Required: Set your SattaBase API key after creating it in SattaBase admin.

# ═════════════════════════════════════════════════════════════════════════════
# SATTABASE INTEGRATION (REQUIRED)
# ═════════════════════════════════════════════════════════════════════════════

# SattaBase Backend API URL (port 8086)
# This is where DealerBackend proxies auth calls
SB_API_BASE_URL=http://localhost:8086/api/v1

# Service API Key from SattaBase admin
# Get this from: http://localhost:4321/admin/api-keys
# Format: sb_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SB_API_KEY=sb_live_your_api_key_here

# This dealer domain identifier
# Must match the ServiceDomain configured in SattaBase
SB_SERVICE_DOMAIN=localhost:4323

# SattaBase Frontend URL (for redirects in emails, etc.)
SB_FRONTEND_URL=http://localhost:4321

# ═════════════════════════════════════════════════════════════════════════════
# JWT VERIFICATION (CRITICAL - MUST MATCH SATTABASE)
# ═════════════════════════════════════════════════════════════════════════════

# JWT Shared Secret - MUST match SB_JWT_SIGNING_KEY in SattaBase .env
# This is REQUIRED for the dealer backend to verify SattaBase JWTs.
# Without this, dealer endpoints will return 403 Forbidden.
#
# Example (from SattaBase .env):
#   SB_JWT_SIGNING_KEY=django-insecure-m3#t!j0&3sck0zplae=r4!@=3tj*h^o&&kyu7%=#rme-l6#-d_p
#   → Set SATTABASE_JWT_SHARED_SECRET to the SAME value
#
# For production with RS256, use SATTABASE_JWT_PUBLIC_KEY instead.
SATTABASE_JWT_SHARED_SECRET=django-insecure-m3#t!j0&3sck0zplae=r4!@=3tj*h^o&&kyu7%=#rme-l6#-d_p

# JWT Algorithm - must match SattaBase (default: HS256)
SATTABASE_JWT_ALGORITHM=HS256

# JWT Issuer - must match SattaBase (optional)
SATTABASE_JWT_ISSUER=sattabase

# JWT Audience - must match SattaBase (optional)
SATTABASE_JWT_AUDIENCE=dealercore

# ═════════════════════════════════════════════════════════════════════════════
# DJANGO CORE SETTINGS
# ═════════════════════════════════════════════════════════════════════════════

# SECURITY WARNING: Change this in production!
SECRET_KEY=change-this-to-a-secure-random-key-in-production

# Debug mode - NEVER use True in production
DEBUG=True

# ═════════════════════════════════════════════════════════════════════════════
# DATABASE
# ═════════════════════════════════════════════════════════════════════════════

# PostgreSQL connection
# Format: postgres://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dealercore

# Or individual settings:
# DB_NAME=dealercore
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# ═════════════════════════════════════════════════════════════════════════════
# REDIS / CACHING (Optional - for production)
# ═════════════════════════════════════════════════════════════════════════════

REDIS_URL=redis://localhost:6379/0

# ═════════════════════════════════════════════════════════════════════════════
# CORS SETTINGS
# ═════════════════════════════════════════════════════════════════════════════

# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:4323,http://localhost:4321

# ═════════════════════════════════════════════════════════════════════════════
# EMAIL SETTINGS (Optional - for notifications)
# ═════════════════════════════════════════════════════════════════════════════

# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=noreply@dealercore.com

# ═════════════════════════════════════════════════════════════════════════════
# FEATURE FLAGS
# ═════════════════════════════════════════════════════════════════════════════

# Enable subscription checking middleware
ENABLE_SUBSCRIPTION_CHECK=True

# Enable access matrix enforcement
ENABLE_ACCESS_MATRIX=True
