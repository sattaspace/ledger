---

<aside
  id="ledger-sidebar"
  class="flex h-full flex-col bg-white dark:bg-navy-900 border-r border-navy-200 dark:border-navy-700"
  role="navigation"
  aria-label="Main navigation"
>
  <!-- Top accent gradient line -->
  <div class="h-1 w-full bg-gradient-to-r from-cyan-500 via-cyan-400 to-warm-500 shrink-0"></div>

  <!-- Logo section -->
  <div class="flex h-14 items-center gap-3 px-5 border-b border-navy-200 dark:border-navy-700 shrink-0">
    <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-cyan-600 text-white font-bold text-sm shadow-md shadow-cyan-600/20">
      L
    </div>
    <span class="text-base font-bold tracking-tight text-navy-900 dark:text-navy-100">Satta Ledger</span>
  </div>

  <!-- Navigation sections -->
  <nav class="flex-1 overflow-y-auto px-3 py-3 space-y-1 sidebar-scroll" aria-label="Sidebar navigation">
    {navSections.map((section, sIdx) => (
      <div class="mb-2" data-sidebar-section={sIdx}>
        <!-- Section toggle -->
        <button
          type="button"
          class="sidebar-section-toggle flex w-full items-center justify-between rounded-lg px-3 py-2 text-xs font-semibold uppercase tracking-wider text-slate-custom-600 dark:text-slate-custom-500 hover:bg-cyan-50 dark:hover:bg-navy-800 transition-colors"
          aria-expanded="true"
          data-section-index={sIdx}
        >
          <span>{section.title}</span>
          <svg
            class="h-3.5 w-3.5 transition-transform duration-200 sidebar-chevron"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>

        <!-- Section items -->
        <div class="sidebar-section-items mt-0.5 space-y-0.5" data-section-items={sIdx}>
          {section.items.map((item) => (
            <a
              href={item.href}
              class="sidebar-nav-item group relative flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium text-slate-custom-700 dark:text-slate-custom-400 hover:bg-cyan-50 dark:hover:bg-navy-800 hover:text-navy-900 dark:hover:text-navy-100 transition-all duration-150"
              data-nav-href={item.href}
            >
              <!-- Active indicator (left bar) -->
              <span class="absolute left-0 top-1/2 -translate-y-1/2 h-5 w-[3px] rounded-r-full bg-cyan-500 scale-y-0 transition-transform duration-150 sidebar-active-bar"></span>

              <svg
                class="h-5 w-5 shrink-0 text-slate-custom-600 dark:text-slate-custom-500 group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={item.icon}></path>
              </svg>
              <span class="truncate">{item.label}</span>
            </a>
          ))}
        </div>
      </div>
    ))}
  </nav>

  <!-- Bottom section -->
  <div class="shrink-0 border-t border-navy-200 dark:border-navy-700 bg-white dark:bg-navy-900">
    <!-- Subscription status bar -->
    <div class="px-4 py-3 border-b border-navy-200 dark:border-navy-700">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <div class="h-2 w-2 rounded-full bg-cyan-500" id="sidebar-plan-dot"></div>
          <span class="text-xs font-medium text-navy-900 dark:text-navy-100" id="sidebar-plan-name">Free Plan</span>
        </div>
        <button
          type="button"
          class="text-xs font-medium text-cyan-600 dark:text-cyan-400 hover:text-cyan-500 transition-colors"
          id="sidebar-manage-plan"
        >
          Manage
        </button>
      </div>
    </div>

    <!-- User info -->
    <div class="px-4 py-3">
      <button
        type="button"
        id="sidebar-user-info"
        class="flex w-full items-center gap-3 rounded-lg p-1 -mx-1 transition-colors hover:bg-cyan-50 dark:hover:bg-navy-800 cursor-pointer text-left"
        title="Manage your account & billing on SattaBase"
      >
        <div
          class="flex h-9 w-9 items-center justify-center rounded-full bg-gradient-to-br from-cyan-500 to-cyan-700 text-white text-xs font-bold shrink-0"
        >
          <span id="sidebar-user-avatar">?</span>
        </div>
        <div class="flex-1 min-w-0">
          <p
            class="truncate text-sm font-medium leading-tight text-navy-900 dark:text-navy-100"
            id="sidebar-user-name"
          >
            Loading...
          </p>
          <p
            class="truncate text-[11px] text-slate-custom-600 dark:text-slate-custom-500 mt-0.5"
            id="sidebar-user-email"
          >
            ...
          </p>
        </div>
        <svg class="h-4 w-4 text-slate-custom-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
        </svg>
      </button>
      <p class="text-[10px] text-slate-custom-500 dark:text-slate-custom-600 mt-1 px-0.5">Opens in SattaBase</p>
    </div>

    <!-- Sign out -->
    <button
      type="button"
      class="flex w-full items-center gap-3 px-5 py-2.5 text-sm font-medium text-slate-custom-600 dark:text-slate-custom-500 transition-all duration-200 hover:bg-red-50 dark:hover:bg-red-950/30 hover:text-red-600 dark:hover:text-red-400 border-t border-navy-200 dark:border-navy-700"
      id="sidebar-sign-out"
      aria-label="Sign out"
    >
      <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
      </svg>
      <span>Sign out</span>
    </button>
  </div>
</aside>

<style>
  .sidebar-scroll::-webkit-scrollbar {
    width: 4px;
  }
  .sidebar-scroll::-webkit-scrollbar-track {
    background: transparent;
  }
  .sidebar-scroll::-webkit-scrollbar-thumb {
    background: var(--color-navy-200);
    border-radius: 9999px;
  }
  .dark .sidebar-scroll::-webkit-scrollbar-thumb {
    background: var(--color-navy-700);
  }
</style>

<script>
  /**
   * Sidebar interactivity — collapsible sections, active nav, keyboard nav.
   */

  // ── Collapsible sections ──
  const sectionToggles = document.querySelectorAll('.sidebar-section-toggle');
  sectionToggles.forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = btn.getAttribute('data-section-index');
      const items = document.querySelector(`[data-section-items="${idx}"]`);
      const chevron = btn.querySelector('.sidebar-chevron');
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';

      if (items) {
        (items as HTMLElement).style.display = isExpanded ? 'none' : 'block';
      }
      if (chevron) {
        chevron.classList.toggle('rotate-180', !isExpanded);
      }
      btn.setAttribute('aria-expanded', String(!isExpanded));
    });
  });

  // ── Active nav indicator ──
  function updateActiveNav() {
    const currentPath = window.location.pathname;
    const navItems = document.querySelectorAll('.sidebar-nav-item');

    navItems.forEach((item) => {
      const href = item.getAttribute('data-nav-href');
      const bar = item.querySelector('.sidebar-active-bar');

      if (href === currentPath || (href !== '/dashboard' && currentPath.startsWith(href + '/'))) {
        item.classList.add('bg-cyan-50', 'dark:bg-cyan-950/30', 'text-navy-900', 'dark:text-navy-100');
        item.classList.remove('text-slate-custom-700', 'dark:text-slate-custom-400');
        if (bar) {
          bar.classList.remove('scale-y-0');
          bar.classList.add('scale-y-100');
        }
      } else {
        item.classList.remove('bg-cyan-50', 'dark:bg-cyan-950/30', 'text-navy-900', 'dark:text-navy-100');
        item.classList.add('text-slate-custom-700', 'dark:text-slate-custom-400');
        if (bar) {
          bar.classList.remove('scale-y-100');
          bar.classList.add('scale-y-0');
        }
      }
    });
  }

  updateActiveNav();
  document.addEventListener('astro:page-load', updateActiveNav);

  // ── User info click → redirect to Account & Billing on base domain ──
  const userInfoBtn = document.getElementById('sidebar-user-info');
  userInfoBtn?.addEventListener('click', async () => {
    try {
      const { redirectToBaseWithAuthCode } = await import('@/lib/auth');
      await redirectToBaseWithAuthCode('/dashboard/profile');
    } catch {
      const { redirectToBase } = await import('@/lib/auth');
      redirectToBase('/dashboard/profile');
    }
  });

  // ── Keyboard navigation ──
  const sidebar = document.getElementById('ledger-sidebar');
  sidebar?.addEventListener('keydown', (e: KeyboardEvent) => {
    const focusable = sidebar.querySelectorAll<HTMLElement>(
      '.sidebar-nav-item, .sidebar-section-toggle'
    );
    const focusArr = Array.from(focusable);
    const currentIdx = focusArr.indexOf(document.activeElement as HTMLElement);

    if (currentIdx === -1) return;

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      const next = focusArr[currentIdx + 1];
      if (next) next.focus();
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      const prev = focusArr[currentIdx - 1];
      if (prev) prev.focus();
    }
  });
</script>
