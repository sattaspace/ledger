---
/**
 * DashboardLayout — authenticated layout with sidebar for sister domains.
 *
 * Checks for JWT token on load. If no token exists, redirects to login.
 * Provides a simple sidebar with navigation and user info.
 * Uses reactive auth state from useAuth composable via a Vue island.
 */

import BaseLayout from "./BaseLayout.astro";
---

<BaseLayout title="Dashboard — SattaBase" description="Your dashboard">
  <div class="flex h-dvh overflow-hidden">
    <!-- Desktop Sidebar -->
    <aside
      class="hidden lg:flex lg:w-64 lg:flex-col lg:fixed lg:inset-y-0 z-30 bg-card/80 border-r border-border"
    >
      <div id="dashboard-sidebar-content" class="flex h-full flex-col">
        <!-- Logo -->
        <div class="flex h-16 items-center gap-3 px-6 border-b border-border">
          <div
            class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-600 text-white font-bold text-sm shadow-md shadow-brand-600/20"
          >
            S
          </div>
          <span class="text-lg font-bold tracking-tight">SattaBase</span>
        </div>

        <!-- Navigation -->
        <nav
          class="flex-1 space-y-1 overflow-y-auto px-3 py-4"
          aria-label="Main navigation"
        >
          <a
            href="/dashboard"
            class="nav-item group relative flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-muted-foreground hover:bg-accent hover:text-foreground transition-all duration-200"
          >
            <svg
              class="h-5 w-5 shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M4 5a1 1 0 011-1h4a1 1 0 011 1v5a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM14 5a1 1 0 011-1h4a1 1 0 011 1v2a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1v-4zM14 12a1 1 0 011-1h4a1 1 0 011 1v7a1 1 0 01-1 1h-4a1 1 0 01-1-1v-7z"
              ></path>
            </svg>
            <span class="truncate">Dashboard</span>
          </a>
        </nav>

        <!-- Bottom section -->
        <div class="border-t border-border bg-card">
          <!-- User info -->
          <div class="px-4 py-3">
            <div
              id="sidebar-user-info"
              class="flex items-center gap-3 rounded-lg p-1 -mx-1 transition-colors hover:bg-accent cursor-pointer"
            >
              <div
                class="flex h-9 w-9 items-center justify-center rounded-full bg-gradient-to-br from-brand-500 to-brand-700 text-white text-xs font-bold shrink-0"
              >
                <span id="sidebar-user-avatar">?</span>
              </div>
              <div class="flex-1 min-w-0">
                <p
                  class="truncate text-sm font-medium leading-tight"
                  id="sidebar-user-name"
                >
                  Loading...
                </p>
                <p
                  class="truncate text-[11px] text-muted-foreground mt-0.5"
                  id="sidebar-user-email"
                >
                  ...
                </p>
              </div>
            </div>
          </div>

          <!-- Sign out -->
          <button
            type="button"
            class="flex w-full items-center gap-3 px-6 py-2.5 text-sm font-medium text-muted-foreground/60 transition-all duration-200 hover:bg-destructive/5 hover:text-destructive border-t border-border"
            id="sidebar-sign-out"
            aria-label="Sign out"
          >
            <svg
              class="h-4 w-4 shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
              ></path>
            </svg>
            <span>Sign out</span>
          </button>
        </div>
      </div>
    </aside>

    <!-- Mobile top bar -->
    <div class="flex flex-1 flex-col min-w-0 lg:pl-64">
      <!-- Top bar -->
      <header
        class="shrink-0 flex h-14 items-center gap-4 border-b border-border bg-card/80 px-4 lg:px-6"
      >
        <!-- Mobile menu toggle -->
        <button
          type="button"
          class="lg:hidden inline-flex items-center justify-center rounded-lg p-2 text-muted-foreground hover:bg-accent hover:text-foreground transition-colors"
          id="mobile-menu-toggle"
          aria-label="Open menu"
        >
          <svg
            class="h-5 w-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>

        <!-- Page title area -->
        <div class="flex-1">
          <h1 class="text-sm font-medium text-foreground" id="page-title">
            Dashboard
          </h1>
        </div>

        <!-- Right side actions -->
        <div class="flex items-center gap-2">
          <!-- Theme toggle -->
          <button
            type="button"
            class="inline-flex items-center justify-center rounded-lg p-2 text-muted-foreground hover:bg-accent hover:text-foreground transition-colors"
            id="theme-toggle"
            aria-label="Toggle dark mode"
          >
            <svg
              class="h-4 w-4 dark:hidden"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
              ></path>
            </svg>
            <svg
              class="h-4 w-4 hidden dark:block"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
              ></path>
            </svg>
          </button>
        </div>
      </header>

      <!-- Content area -->
      <main class="flex-1 overflow-y-auto">
        <div class="p-4 md:p-6 lg:p-8">
          <div class="mx-auto max-w-7xl">
            <slot />
          </div>
        </div>
      </main>
    </div>
  </div>
</BaseLayout>

<script>
  // ── Sign out handler ──
  const signOutBtn = document.getElementById("sidebar-sign-out");
  signOutBtn?.addEventListener("click", async () => {
    try {
      const { logout } = await import("@/lib/auth");
      await logout();
    } catch {
      // Fallback: clear tokens manually
      const { clearTokens } = await import("@/lib/api");
      clearTokens();
      window.location.href = "/auth/login";
    }
  });

  // ── Theme toggle ──
  const themeToggle = document.getElementById("theme-toggle");
  themeToggle?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
  });

  // ── Load user info into sidebar ──
  async function loadSidebarUserInfo() {
    try {
      const { apiClient } = await import("@/lib/api");
      const data = await apiClient.get<{ user: any; subscription: any }>(
        "/billing/auth/me",
      );

      const userName = document.getElementById("sidebar-user-name");
      const userEmail = document.getElementById("sidebar-user-email");
      const userAvatar = document.getElementById("sidebar-user-avatar");

      if (data?.user) {
        const name =
          data.user.full_name ||
          data.user.display_name ||
          data.user.email?.split("@")[0] ||
          "User";
        if (userName) userName.textContent = name;
        if (userEmail) userEmail.textContent = data.user.email || "";
        if (userAvatar) userAvatar.textContent = name.charAt(0).toUpperCase();
      }
    } catch {
      // Not authenticated — sidebar shows defaults
    }
  }

  loadSidebarUserInfo();
  document.addEventListener("astro:page-load", loadSidebarUserInfo);
</script>
