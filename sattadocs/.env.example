# SattaDocs — Environment Variables
# Copy this file to .env and fill in the values.
# In development, these are auto-loaded from the parent .env file.

# Sattabase Backend API URL (used for staff authentication)
# The middleware and API routes call GET /users/me on this URL
# to validate staff JWT tokens.
SB_BACKEND_PUBLIC_API_URL=http://localhost:8000/api/v1

# Alternative: use the public API base URL from the main sattabase .env
# PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Node environment
# NODE_ENV=development
